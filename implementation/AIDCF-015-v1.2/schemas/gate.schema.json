{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "status",
    "sourceArtifact",
    "gateId",
    "state",
    "controlRefs",
    "evidenceRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.2"
    },
    "status": {
      "type": "string"
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "gateId": {
      "pattern": "^CG-(0[1-9]|1[0-5])$"
    },
    "state": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "APPROVED_NA",
        "NOT_ASSESSED"
      ]
    },
    "controlRefs": {
      "type": "array",
      "items": {
        "pattern": "^MCF-[A-Z]{3}-\\d{3}$"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$id": "urn:aidcf:schema:gate:1.2",
  "additionalProperties": true
}
