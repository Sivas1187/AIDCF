{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "status",
    "sourceArtifact",
    "evidenceClass",
    "sha256",
    "supportsControlRefs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.2"
    },
    "status": {
      "type": "string"
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "evidenceClass": {
      "type": "string"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "supportsControlRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "pattern": "^MCF-[A-Z]{3}-\\d{3}$"
      }
    }
  },
  "$id": "urn:aidcf:schema:evidence:1.2",
  "additionalProperties": true
}
