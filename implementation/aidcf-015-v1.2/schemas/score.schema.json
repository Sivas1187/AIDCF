{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "type",
    "version",
    "status",
    "sourceArtifact",
    "rawScore",
    "controlAssessments",
    "calculationHash"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.2"
    },
    "status": {
      "type": "string"
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "rawScore": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "controlAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "calculationHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$id": "urn:aidcf:schema:score:1.2",
  "additionalProperties": true
}
