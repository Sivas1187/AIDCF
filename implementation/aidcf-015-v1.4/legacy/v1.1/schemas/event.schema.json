{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidcf:schema:event:1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.1"
    },
    "status": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "eventType": {
      "type": "string"
    },
    "subjectRef": {
      "type": "string"
    },
    "affectedRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewState": {
      "enum": [
        "CANDIDATE",
        "REVIEWED",
        "APPROVED",
        "REJECTED"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "status",
    "classification",
    "sourceArtifact",
    "eventType",
    "subjectRef",
    "affectedRefs",
    "reviewState"
  ]
}
