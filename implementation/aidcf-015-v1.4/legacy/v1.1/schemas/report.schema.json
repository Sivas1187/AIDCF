{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidcf:schema:report:1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.1"
    },
    "status": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "reportClass": {
      "enum": [
        "R1",
        "R2"
      ]
    },
    "decisionRef": {
      "type": "string"
    },
    "decisionState": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validity": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "status",
    "classification",
    "sourceArtifact",
    "reportClass",
    "decisionRef",
    "decisionState",
    "limitations",
    "validity"
  ]
}
