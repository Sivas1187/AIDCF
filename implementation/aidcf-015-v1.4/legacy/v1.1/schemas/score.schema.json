{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidcf:schema:score:1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.1"
    },
    "status": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "profile": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "rawScore": {
      "type": "number"
    },
    "coverage": {
      "type": "number"
    },
    "gateOverlay": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reperformanceHash": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "status",
    "classification",
    "sourceArtifact",
    "profile",
    "inputs",
    "rawScore",
    "coverage",
    "gateOverlay",
    "reperformanceHash"
  ]
}
