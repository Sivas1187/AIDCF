  },
  {
   "id": "https://w3id.org/aidcf/id/control/MCF-PHY-004",
   "type": "Control",
   "name": "Adjacent Risk",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to multi-occupancy buildings, campuses and colocation facilities. A standalone single-occupier building with no shared structure records the determination and is otherwise not applicable.",
   "assessmentCriteria": [
    "An adjacency register identifies every occupancy sharing a structural element, riser or plant space with the facility.",
    "Each adjacent risk has a recorded separation measure (fire rating, physical barrier, drainage, vibration isolation) or an approved risk acceptance.",
    "Notification arrangements exist for adjacent works (hot works, roof works, demolition) that could affect the facility.",
    "Emergency coordination with adjacent occupiers is documented, including shared alarms and evacuation interfaces."
   ],
