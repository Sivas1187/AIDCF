  {
   "id": "https://w3id.org/aidcf/id/control/MCF-THM-024",
   "type": "Control",
   "name": "Thermal Recovery",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all heat-removal paths serving in-scope IT.",
   "assessmentCriteria": [
    "A recovery procedure defines restart sequence, prerequisites and hold points.",
    "Verification criteria for each step (flow, pressure, temperature, no leak) are defined.",
    "Staged IT readmission limits are defined and agreed with the AI platform operator.",
    "The procedure has been exercised (test or real event) within the interval, achieving the recovery time objective.",
    "Lessons from exercises and incidents are incorporated."
   ],
   "assessmentMethods": [
    "SCENARIO_EXERCISE",
    "DOCUMENT_REVIEW",
    "ANALYSIS",
    "INQUIRY"
   ],
   "claimType": "RESILIENCE",
