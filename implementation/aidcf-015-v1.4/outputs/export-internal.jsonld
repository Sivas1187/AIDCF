  {
   "id": "https://w3id.org/aidcf/id/control/MCF-PHY-002",
   "type": "Control",
   "name": "External Exposure",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to owned and leased sites; for colocation the assessed party relies on the provider's register and perimeter evidence. Not applicable where the site is wholly within a host facility whose perimeter is assessed as a separate boundary element.",
   "assessmentCriteria": [
    "An external exposure register exists covering the declared radius, with each exposure's consequence path to site infrastructure described.",
    "Hostile vehicle mitigation at the perimeter is rated to the vehicle mass and speed set in the threat assessment and covers all vehicle-accessible approaches to critical plant.",
    "Redundant utility intakes, generator yards and heat-rejection plant are separated so that a single external event in the register cannot reach both.",
    "Air intakes for halls and plant are located and protected against smoke, exhaust re-entrainment (including from the site's own generators) and corrosive emissions identified in the register.",
    "Exposure changes in the surrounding area are monitored and the register is reviewed at the declared interval."
   ],
   "assessmentMethods": [
    "DOCUMENT_REVIEW",
    "INSPECTION",
    "ANALYSIS"
   ],
   "claimType": "DESIGN",
   "classification": "INTERNAL",
   "controlCode": "MCF-PHY-002",
