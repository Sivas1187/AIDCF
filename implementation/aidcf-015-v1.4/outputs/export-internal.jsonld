  {
   "id": "https://w3id.org/aidcf/id/control/MCF-PHY-005",
   "type": "Control",
   "name": "Structural Capacity",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all facilities and to colocation suites where the tenant's equipment imposes load; the tenant obtains the provider's rated capacity and supplies its own load schedule.",
   "assessmentCriteria": [
    "Structural capacity is stated for every area hosting IT, power, battery or cooling equipment, in kN/m\u00b2 distributed and kN concentrated.",
    "The load model uses operating mass including coolant, not dry shipping mass, for liquid-cooled equipment and pipework.",
    "Roof and plant-deck capacity covers heat-rejection plant at operating weight, including any additions for AI expansion.",
    "Raised-floor pedestals and panels, where used, are rated for rolling and concentrated loads of the heaviest rack during movement.",
    "Planned load per area is below the utilisation threshold, or a structural re-check is on file."
   ],
   "assessmentMethods": [
