   "name": "Agent or Automation Authority",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to every automated or AI-enabled actor with any authority beyond OBSERVE over in-scope infrastructure.",
   "assessmentCriteria": [
    "All automations and agents with infrastructure authority are registered with identity, tools, targets, actions, limits, states and owner.",
    "Effective permissions reconcile to registered scope (no excess).",
