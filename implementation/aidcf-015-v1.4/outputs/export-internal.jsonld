  {
   "id": "https://w3id.org/aidcf/id/control/MCF-NET-018",
   "type": "Control",
   "name": "Optics Compatibility",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all pluggable optics, AOCs and DACs in in-scope fabrics; for co-packaged or linear-drive optics, the matrix records host and module firmware combinations.",
   "assessmentCriteria": [
    "A qualified-optics matrix exists with part numbers, firmware, host combinations and link-budget class.",
    "Installed optics inventory reconciles to the matrix; unqualified parts are listed and dispositioned.",
    "Optical diagnostics are collected for all optics with thresholds for low Rx power and high temperature.",
    "Measured link loss for a sample of links is within the transceiver budget with the defined margin.",
    "Optics firmware is at qualified versions; mixed versions within a fabric are justified.",
    "Failure and RMA data are analysed for batch or lot-level common modes."
   ],
   "assessmentMethods": [
    "RECONCILIATION",
    "ANALYSIS",
    "SAMPLING",
    "DOCUMENT_REVIEW"
