  {
   "id": "https://w3id.org/aidcf/id/control/MCF-NET-010",
   "type": "Control",
   "name": "Frontend Network",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to front-end networks serving in-scope inference, orchestration and data-ingest. Where the front end is provided by a cloud or colocation provider, the provider boundary (DEP-018) governs evidence rights.",
   "assessmentCriteria": [
    "Approved front-end design exists with attachment, routing, capacity and redundancy stated.",
    "As-built attachment and routing configuration reconcile to design.",
    "Inference and orchestration endpoints have redundant attachment or an accepted single-homed rationale.",
    "Capacity for declared inference request and ingest peaks is demonstrated by telemetry or test.",
    "Single-switch or uplink failure has been tested or observed with effect within tolerance."
   ],
   "assessmentMethods": [
    "DOCUMENT_REVIEW",
    "RECONCILIATION",
    "ANALYSIS",
    "SAMPLING"
   ],
