  {
   "id": "https://w3id.org/aidcf/id/control/MCF-NET-002",
   "type": "Control",
   "name": "Path Diversity",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to every network path relied upon as redundant for an in-scope outcome, including WAN/DCI used for multi-site training, replication or alternate capacity. Not applicable to paths whose loss is explicitly tolerated by the Service Outcome.",
   "assessmentCriteria": [
    "Each redundant path group has documented diversity requirements derived from the outcome criticality.",
    "Route evidence for each external circuit identifies building entry, route and any shared segments to a defined granularity.",
    "Intra-site redundant trunks are routed in separate containment or the shared section is analysed and accepted.",
    "Carrier diversity accounts for wholesale or tail-circuit sharing (diverse brand on a shared underlying route is not treated as diverse).",
    "Shared segments are registered as common-mode dependencies with owners and linked to DEP-007.",
    "Diversity is re-verified after carrier grooming or re-routing notices."
   ],
   "assessmentMethods": [
    "DOCUMENT_REVIEW",
    "INSPECTION",
    "ANALYSIS",
    "RECONCILIATION",
    "INQUIRY"
   ],
