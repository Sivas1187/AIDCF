  {
   "id": "urn:aidcf:syn:statement:AS-001",
   "type": "AssuranceStatement",
   "name": "Synthetic assurance statement",
   "audience": "Synthetic internal stakeholders",
   "classification": "INTERNAL",
   "createdAt": "2026-10-10T00:00:00Z",
   "createdBy": "urn:aidcf:syn:party:BUILDER",
   "decisionRef": "urn:aidcf:syn:decision:AD-001",
   "decisionState": "NOT_ASSURED",
   "effectiveFrom": "2026-10-10T00:00:00Z",
   "effectiveTo": "2027-04-10T00:00:00Z",
   "permittedClaims": [
    "The synthetic capability was assessed against 12 of 360 AIDCF-007A controls."
   ],
   "prohibitedClaims": [
    "Any claim of certification.",
    "Any claim of assurance stronger than NOT_ASSURED, including INCONCLUSIVE: the CG-07 failure is demonstrated, not undetermined."
   ],
   "provenance": {
    "sourceSystem": "AIDCF-015 v1.4 tools/build_dataset.py",
    "method": "SYNTHETIC_AUTHORING",
    "synthetic": true,
    "transformationVersion": "1.4"
   },
   "releaseRef": "AIDCF-REL-2026.10.2",
   "reportedIn": [
    "urn:aidcf:syn:report:RPT-001"
   ],
   "schemaVersion": "1.3",
   "scope": {
    "capabilityRef": "urn:aidcf:syn:capability:CI-001",
    "snapshotRef": "urn:aidcf:syn:snapshot:SNAP-001"
   },
   "semanticOwner": "AIDCF-012",
   "sourceArtifact": "AIDCF-015",
   "statementText": "The synthetic assessment is NOT_ASSURED. CG-07 (critical control-system integrity) FAILS on PARTIAL CRITICAL controls MCF-OPS-013 and MCF-SEC-005, and its FAIL ceiling is NOT_ASSURED for the Service Outcomes that depend on BMS supervision of power and cooling (RF-06, required by SO-01); the decision question is not partitioned by outcome, so that ceiling applies to SO-01 to SO-03. CG-03 and CG-15 also FAIL (NOT_ASSURED for the outcomes their defeated dependency and authority paths reach; LIMITED for the decision as a whole). The CG-01 and CG-05 UNKNOWN gates and the systemic US5 UNKNOWN U-003 on the facility water plant each cap the decision at INCONCLUSIVE; none raises it above NOT_ASSURED, because a demonstrated gate failure is not softened by undetermined positions.",
   "status": "REVIEWED",
   "version": "1.0"
  },
