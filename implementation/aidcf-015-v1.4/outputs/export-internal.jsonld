  {
   "id": "https://w3id.org/aidcf/id/control/MCF-DEP-013",
   "type": "Control",
   "name": "Capacity Concentration",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all Capability Instances with more than one fault domain; a single-fault-domain capability records 100% concentration and its acceptance.",
   "assessmentCriteria": [
    "Concentration is calculated for every fault domain in the RES-02 model, using current deployment data.",
    "The concentration limit is derived from and traceable to the Service Outcome impact tolerance.",
    "Fault domains exceeding the limit have an approved treatment or acceptance.",
    "Calculations account for job topology: training jobs spanning several fault domains are counted as lost if any spanned domain fails, unless elastic recovery is evidenced."
   ],
   "assessmentMethods": [
    "ANALYSIS",
    "DOCUMENT_REVIEW",
    "RECONCILIATION"
   ],
