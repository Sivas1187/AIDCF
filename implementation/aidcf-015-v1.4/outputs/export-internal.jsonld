   ],
   "objective": "Ensure conduits between zones are enforced by managed boundary devices whose rule sets are minimal, reviewed and monitored, including industrial DMZs, unidirectional gateways and API gateways for automation.",
   "profileTier": "CP-3",
   "provenance": {
    "sourceSystem": "AIDCF-007A registry v1.1 (controls.csv)",
    "method": "REGISTRY_IMPORT",
    "synthetic": false,
    "transformationVersion": "1.4",
    "legacyValue": "status=CANDIDATE"
   },
   "releaseRef": "AIDCF-REL-2026.10.2",
   "requiredAssuranceLevel": "AL4",
   "requirement": "The security operations manager shall operate boundary devices on every conduit in the zone model with deny-by-default rule sets, documented business justification and owner for each rule, review of rules at a defined interval, removal of unused rules, and logging of denied and permitted consequential flows to security telemetry. The OT security owner shall use unidirectional or protocol-break gateways where the zone model requires one-way data export from power and cooling control zones.",
   "schemaVersion": "1.3",
   "semanticOwner": "AIDCF-007A",
   "sourceArtifact": "AIDCF-007A",
   "sourceRecord": "registries/controls/controls.csv#MCF-SEC-011",
   "status": "CANDIDATE",
   "version": "1.0"
  },
  {
   "id": "https://w3id.org/aidcf/id/control/MCF-SEC-012",
   "type": "Control",
   "name": "Remote Access",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all remote access to in-scope OT, management and control-plane systems. Supplier-side identity and contractual obligations are SUP-021 to SUP-024.",
   "assessmentCriteria": [
    "All remote access paths to in-scope systems traverse the managed gateway (no alternative paths found in discovery).",
    "Vendor/OEM sessions require per-session approval and are time-limited.",
    "Sessions are recorded and can be terminated in real time (demonstrated).",
    "Persistent vendor connections and unmanaged remote tools are absent.",
    "Remote write/command sessions to OT systems were supervised (sampled).",
    "Revocation of a vendor's access takes effect within the defined time (tested)."
   ],
   "assessmentMethods": [
    "TEST",
    "SAMPLING",
    "INSPECTION",
    "ANALYSIS"
   ],
