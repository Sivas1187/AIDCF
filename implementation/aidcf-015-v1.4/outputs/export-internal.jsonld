   ],
   "objective": "Establish an authoritative, versioned model of the heat that each fault domain must reject, split by heat-removal path (air, direct-to-chip liquid, rear-door, immersion), so that every downstream capacity, redundancy and recovery claim is tested against a defensible demand figure rather than nameplate or average IT power.",
   "profileTier": "CP-1",
   "provenance": {
    "sourceSystem": "AIDCF-007A registry v1.1 (controls.csv)",
    "method": "REGISTRY_IMPORT",
    "synthetic": false,
    "transformationVersion": "1.4",
    "legacyValue": "status=CANDIDATE"
   },
   "releaseRef": "AIDCF-REL-2026.10.2",
   "requiredAssuranceLevel": "AL2",
   "requirement": "The thermal engineering authority shall maintain a versioned heat-load model for each Capability Instance that states, per hall, row, rack group and CDU or air-handling fault domain, the design and peak heat load in kW, the liquid-capture ratio by platform, residual heat to air, and the transient load profile of synchronous AI training. The facility owner shall approve the model and shall not accept capacity claims that are not traceable to the current model version.",
   "schemaVersion": "1.3",
   "semanticOwner": "AIDCF-007A",
   "sourceArtifact": "AIDCF-007A",
   "sourceRecord": "registries/controls/controls.csv#MCF-THM-001",
   "status": "CANDIDATE",
   "version": "1.0"
  },
  {
   "id": "https://w3id.org/aidcf/id/control/MCF-THM-002",
   "type": "Control",
   "name": "Design Capacity",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all in-scope heat-removal stages. For colocation where the operator provides cooling as a service, applies to the provider-supplied evidence under the service interface.",
   "assessmentCriteria": [
    "A stage-by-stage capacity table exists (CRAH/fan wall, rear-door, CDU, TCS pumps, FWS pumps, chillers, dry coolers or towers) with rated and commissioned capacity at stated conditions.",
    "The weakest stage in each path is identified and its commissioned capacity is \u2265 design load plus margin.",
    "Commissioning (functional and integrated systems tests) was performed at or extrapolated with documented method to design load using load banks or equivalent.",
    "Capacity ratings are stated at the actual design supply temperature and \u0394T, not catalogue nominal conditions.",
    "Admitted IT load is reconciled to the demonstrated capacity and no fault domain exceeds it."
   ],
