   "hasEvidenceRequirement": [
    "https://w3id.org/aidcf/id/evidence-requirement/MCF-PHY-002-DESIGN"
   ],
   "objective": "Ensure that threats and hazards originating outside the site boundary, including adjacent industrial activity, transport corridors, airspace, hostile vehicles and airborne contaminants, are characterised and mitigated so that they cannot disable redundant infrastructure together.",
   "profileTier": "CP-2",
   "provenance": {
    "sourceSystem": "AIDCF-007A registry v1.1 (controls.csv)",
    "method": "REGISTRY_IMPORT",
    "synthetic": false,
    "transformationVersion": "1.4",
    "legacyValue": "status=CANDIDATE"
   },
   "releaseRef": "AIDCF-REL-2026.10.2",
   "requiredAssuranceLevel": "AL2",
   "requirement": "The facility owner shall identify external exposures within a defined radius of the site, including major-accident-hazard installations, pipelines, rail and road corridors carrying hazardous goods, flight paths, high-voltage corridors and sources of smoke or corrosive emissions. The facility owner shall specify perimeter protection (stand-off, hostile vehicle mitigation, blast and intrusion resistance) proportionate to the assessed threat, and shall show that no single external event can impair both redundant utility intakes, both generator yards or all heat-rejection plant.",
   "schemaVersion": "1.3",
   "semanticOwner": "AIDCF-007A",
   "sourceArtifact": "AIDCF-007A",
   "sourceRecord": "registries/controls/controls.csv#MCF-PHY-002",
   "status": "CANDIDATE",
   "version": "1.0"
  },
  {
   "id": "https://w3id.org/aidcf/id/control/MCF-PHY-003",
   "type": "Control",
   "name": "Access and Logistics",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all sites hosting rack-scale or liquid-cooled AI systems and to any site relying on fuel deliveries for autonomy. Reduced scope applies to colocation tenants, who verify only the IT delivery route and rely on provider evidence for plant and fuel routes.",
   "assessmentCriteria": [
    "Each route in the plan states the governing constraint (door clear opening, lift rating, ramp gradient, slab or dock rating) and the heaviest item it is verified for.",
    "The heaviest declared fully populated rack (including integrated liquid-cooling manifolds) can be moved from dock to its final position without exceeding any route rating.",
    "A replacement path exists for each transformer, generator and chiller that does not require de-energising the redundant counterpart.",
    "At least the declared number of independent access routes for fuel tankers and fire appliances exists and has been driven or walked within the review period.",
    "Logistics constraints are communicated to IT deployment teams before procurement of new rack types."
   ],
   "assessmentMethods": [
    "DOCUMENT_REVIEW",
    "INSPECTION",
    "SAMPLING",
    "OBSERVATION"
   ],
