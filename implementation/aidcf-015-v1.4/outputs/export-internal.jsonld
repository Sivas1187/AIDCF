  {
   "id": "https://w3id.org/aidcf/id/control/MCF-POW-004",
   "type": "Control",
   "name": "Utility Contingency",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to sites with grid connection agreements that include curtailment, flexibility or large-load obligations, and to all sites for prolonged outage planning.",
   "assessmentCriteria": [
    "The plan covers prolonged outage, curtailment instruction, demand response and re-energisation.",
    "Load-reduction steps identify workloads (by class or cluster), expected MW reduction and time to achieve it.",
    "Workload throttling or checkpoint-and-pause is demonstrated in an exercise to achieve the declared reduction within the declared time.",
    "Contractual obligations as a large load (notification, ride-through, ramp limits) are listed and mapped to procedures.",
    "Decision authority and network-operator contacts are current."
   ],
   "assessmentMethods": [
