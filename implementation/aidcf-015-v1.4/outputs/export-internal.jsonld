  {
   "id": "https://w3id.org/aidcf/id/control/MCF-CAP-001",
   "type": "Control",
   "name": "Capability Register",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to every assurance programme; there is no assurance subject without it.",
   "assessedBy": [
    "urn:aidcf:syn:control-assessment:CA-001"
   ],
   "assessmentCriteria": [
    "Every Capability Instance has a unique, stable identifier and the required attributes (work type, location, tenancy model, lifecycle status, owner, Service Outcomes, ArchitectureSnapshot reference).",
    "Every accelerator cluster, pod or service pool present in the scheduler or orchestration inventory is assigned to exactly one Capability Instance or recorded as out of scope with rationale.",
    "Every Capability Instance in the register maps to physical locations present in the facility asset register.",
    "The last reconciliation is within the reconciliation interval and after every material change in the period.",
    "No assurance report in the period refers to a capability not present in the register at the report date."
   ],
   "assessmentMethods": [
    "RECONCILIATION",
    "INSPECTION",
    "DOCUMENT_REVIEW",
    "ANALYSIS"
   ],
