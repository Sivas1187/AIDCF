  },
  {
   "id": "https://w3id.org/aidcf/id/control/MCF-DEP-011",
   "type": "Control",
   "name": "OEM Dependency",
   "amendmentRef": "AIDCF-007A-AMD-002",
   "applicability": "Applies to all critical asset classes. Supplier due diligence and contract terms are assessed under SUP; this control records the dependency itself.",
   "assessmentCriteria": [
    "Every critical asset class in the asset-to-function map has an OEM dependency entry with current support entitlement and expiry.",
    "Operating dependencies on OEM services (licence activation, entitlement checks, cloud management portals, remote diagnostics) are recorded with the effect of their loss on each Required Function.",
    "Proprietary diagnostic or recovery tools are held on site or in an accessible repository with licences valid for emergency use.",
