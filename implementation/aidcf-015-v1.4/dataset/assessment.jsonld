  {
   "id": "urn:aidcf:syn:procedure:AP-001",
   "type": "AssessmentProcedure",
   "name": "Procedure for MCF-CAP-001",
   "assessmentMethods": [
    "RECONCILIATION",
    "INSPECTION",
    "DOCUMENT_REVIEW",
    "ANALYSIS"
   ],
   "claimType": "IMPLEMENTATION",
   "classification": "INTERNAL",
   "controlRef": "https://w3id.org/aidcf/id/control/MCF-CAP-001",
   "createdAt": "2026-10-10T00:00:00Z",
   "createdBy": "urn:aidcf:syn:party:BUILDER",
   "effectiveFrom": "2026-10-10T00:00:00Z",
   "procedureSteps": [
    "Obtain the register extract and check each instance for the required attributes.",
    "Extract the scheduler or orchestration inventory and reconcile clusters, pods and node counts to Capability Instances.",
    "Reconcile instance locations to the facility asset register.",
    "Analyse unmatched items and their dispositions; treat unexplained differences as Findings.",
    "Check reconciliation dates against the interval and change events.",
    "Compare capabilities named in reports issued in the period with the register."
   ],
