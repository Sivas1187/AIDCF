{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aidcf:schema:decision:1.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "version": {
      "const": "1.1"
    },
    "status": {
      "type": "string"
    },
    "classification": {
      "enum": [
        "INTERNAL",
        "CONFIDENTIAL"
      ]
    },
    "sourceArtifact": {
      "const": "AIDCF-015"
    },
    "decisionState": {
      "enum": [
        "LIMITED",
        "CONDITIONALLY_ASSURED",
        "REASONABLY_ASSURED",
        "ADVERSE_NOT_ASSURED",
        "UNKNOWN_INCONCLUSIVE",
        "SUSPENDED",
        "WITHDRAWN",
        "SUPERSEDED"
      ]
    },
    "gateRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknownRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "string"
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "version",
    "status",
    "classification",
    "sourceArtifact",
    "decisionState",
    "gateRefs",
    "unknownRefs",
    "authority",
    "supersedes"
  ]
}
