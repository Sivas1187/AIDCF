{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aidcf/schema/1.3/evidence.schema.json",
  "title": "AIDCF Evidence Object (EvidenceObject)",
  "description": "A record or observation, with provenance and integrity, used to support, challenge or qualify an assertion.",
  "x-aidcf-class": "https://w3id.org/aidcf/ontology#EvidenceObject",
  "x-aidcf-semantic-owner": "AIDCF-008",
  "x-aidcf-registration": "canonical",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "semanticOwner",
    "schemaVersion",
    "version",
    "status",
    "releaseRef",
    "sourceArtifact",
    "name",
    "effectiveFrom",
    "createdAt",
    "createdBy",
    "classification",
    "provenance",
    "evidenceClass",
    "evidenceSource",
    "collector",
    "custodian",
    "periodStart",
    "periodEnd",
    "operatingStates",
    "integrityLevel",
    "sha256",
    "byteSize",
    "mediaType",
    "qualityVector",
    "qualityBand",
    "sufficiency"
  ],
  "properties": {
    "@context": {
      "$ref": "common-envelope.schema.json#/properties/@context"
    },
    "id": {
      "$ref": "common-envelope.schema.json#/properties/id"
    },
    "type": {
      "const": "EvidenceObject"
    },
    "semanticOwner": {
      "$ref": "common-envelope.schema.json#/properties/semanticOwner"
    },
    "schemaVersion": {
      "$ref": "common-envelope.schema.json#/properties/schemaVersion"
    },
    "version": {
      "$ref": "common-envelope.schema.json#/properties/version"
    },
    "status": {
      "$ref": "common-envelope.schema.json#/properties/status"
    },
    "releaseRef": {
      "$ref": "common-envelope.schema.json#/properties/releaseRef"
    },
    "sourceArtifact": {
      "$ref": "common-envelope.schema.json#/properties/sourceArtifact"
    },
    "name": {
      "$ref": "common-envelope.schema.json#/properties/name"
    },
    "effectiveFrom": {
      "$ref": "common-envelope.schema.json#/properties/effectiveFrom"
    },
    "createdAt": {
      "$ref": "common-envelope.schema.json#/properties/createdAt"
    },
    "createdBy": {
      "$ref": "common-envelope.schema.json#/properties/createdBy"
    },
    "classification": {
      "$ref": "common-envelope.schema.json#/properties/classification"
    },
    "provenance": {
      "$ref": "common-envelope.schema.json#/properties/provenance"
    },
    "sourceRecord": {
      "$ref": "common-envelope.schema.json#/properties/sourceRecord"
    },
    "description": {
      "$ref": "common-envelope.schema.json#/properties/description"
    },
    "scope": {
      "$ref": "common-envelope.schema.json#/properties/scope"
    },
    "effectiveTo": {
      "$ref": "common-envelope.schema.json#/properties/effectiveTo"
    },
    "modifiedAt": {
      "$ref": "common-envelope.schema.json#/properties/modifiedAt"
    },
    "modifiedBy": {
      "$ref": "common-envelope.schema.json#/properties/modifiedBy"
    },
    "distributionControlRef": {
      "$ref": "common-envelope.schema.json#/properties/distributionControlRef"
    },
    "reviewState": {
      "$ref": "common-envelope.schema.json#/properties/reviewState"
    },
    "supersedes": {
      "$ref": "common-envelope.schema.json#/properties/supersedes"
    },
    "externalIdentifiers": {
      "$ref": "common-envelope.schema.json#/properties/externalIdentifiers"
    },
    "extensions": {
      "$ref": "common-envelope.schema.json#/properties/extensions"
    },
    "nullReasons": {
      "$ref": "common-envelope.schema.json#/properties/nullReasons"
    },
    "hasUnknown": {
      "$ref": "common-envelope.schema.json#/properties/hasUnknown"
    },
    "reviewedBy": {
      "$ref": "common-envelope.schema.json#/properties/reviewedBy"
    },
    "migratedFrom": {
      "$ref": "common-envelope.schema.json#/properties/migratedFrom"
    },
    "integrationHandoff": {
      "$ref": "common-envelope.schema.json#/properties/integrationHandoff"
    },
    "governedBy": {
      "$ref": "common-envelope.schema.json#/properties/governedBy"
    },
    "evidenceClass": {
      "$ref": "definitions.schema.json#/$defs/code-EvidenceClass"
    },
    "evidenceSource": {
      "type": "string",
      "minLength": 1
    },
    "collector": {
      "$ref": "definitions.schema.json#/$defs/iri"
    },
    "custodian": {
      "$ref": "definitions.schema.json#/$defs/iri"
    },
    "periodStart": {
      "$ref": "definitions.schema.json#/$defs/date"
    },
    "periodEnd": {
      "$ref": "definitions.schema.json#/$defs/date"
    },
    "operatingStates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/code-OperatingState"
      }
    },
    "integrityLevel": {
      "$ref": "definitions.schema.json#/$defs/code-IntegrityLevel"
    },
    "sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    },
    "byteSize": {
      "type": "integer",
      "minimum": 0
    },
    "mediaType": {
      "type": "string",
      "minLength": 1
    },
    "qualityVector": {
      "$ref": "definitions.schema.json#/$defs/obj-QualityVector"
    },
    "qualityBand": {
      "$ref": "definitions.schema.json#/$defs/code-QualityBand"
    },
    "sufficiency": {
      "$ref": "definitions.schema.json#/$defs/code-Sufficiency"
    },
    "fixturePath": {
      "type": "string",
      "minLength": 1
    },
    "confidenceFlags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/code-ConfidenceFlag"
      }
    },
    "supports": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "challenges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "qualifies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "invalidatedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    }
  },
  "if": {
    "properties": {
      "classification": {
        "enum": [
          "CLIENT_RESTRICTED",
          "CONFIDENTIAL",
          "HIGHLY_RESTRICTED"
        ]
      }
    },
    "required": [
      "classification"
    ]
  },
  "then": {
    "required": [
      "distributionControlRef"
    ]
  }
}
