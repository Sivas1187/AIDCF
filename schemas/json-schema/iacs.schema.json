{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aidcf/schema/1.3/iacs.schema.json",
  "title": "AIDCF Industrial Automation and Control System (IACS)",
  "description": "Industrial Automation and Control System: the personnel, hardware, software and policies that operate, monitor and protect a physical process. In AIDCF, the control systems of power, cooling, fire and building services, including their engineering workstations, historians and gateways. Subclass of InfrastructureSystem.",
  "x-aidcf-class": "https://w3id.org/aidcf/ontology#IACS",
  "x-aidcf-semantic-owner": "AIDCF-003",
  "x-aidcf-registration": "supporting",
  "type": "object",
  "additionalProperties": false,
