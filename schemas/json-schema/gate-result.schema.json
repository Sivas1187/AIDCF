{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aidcf/schema/1.3/gate-result.schema.json",
  "title": "AIDCF Gate Result (GateResult)",
  "description": "The evaluated status of one CriticalGate in one assessment scope (PASS, FAIL, UNKNOWN, APPROVED_NA, NOT_ASSESSED) with its inputs.",
  "x-aidcf-class": "https://w3id.org/aidcf/ontology#GateResult",
  "x-aidcf-semantic-owner": "AIDCF-010",
  "x-aidcf-registration": "canonical",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "semanticOwner",
    "schemaVersion",
    "version",
    "status",
    "releaseRef",
    "sourceArtifact",
    "name",
    "effectiveFrom",
    "createdAt",
    "createdBy",
    "classification",
    "provenance",
    "evaluatesGate",
    "gateCode",
    "gateApplicability",
    "controlEvaluations",
    "criteriaResults",
    "evidenceSufficiency",
    "stateCoverage",
    "gateState",
    "decisionEffect",
    "rollupRationale",
    "reviewState",
    "scope"
  ],
  "properties": {
    "@context": {
      "$ref": "common-envelope.schema.json#/properties/@context"
    },
    "id": {
      "$ref": "common-envelope.schema.json#/properties/id"
    },
    "type": {
      "const": "GateResult"
    },
    "semanticOwner": {
      "$ref": "common-envelope.schema.json#/properties/semanticOwner"
    },
    "schemaVersion": {
      "$ref": "common-envelope.schema.json#/properties/schemaVersion"
    },
    "version": {
      "$ref": "common-envelope.schema.json#/properties/version"
    },
    "status": {
      "$ref": "common-envelope.schema.json#/properties/status"
    },
    "releaseRef": {
      "$ref": "common-envelope.schema.json#/properties/releaseRef"
    },
    "sourceArtifact": {
      "$ref": "common-envelope.schema.json#/properties/sourceArtifact"
    },
    "name": {
      "$ref": "common-envelope.schema.json#/properties/name"
    },
    "effectiveFrom": {
      "$ref": "common-envelope.schema.json#/properties/effectiveFrom"
    },
    "createdAt": {
      "$ref": "common-envelope.schema.json#/properties/createdAt"
    },
    "createdBy": {
      "$ref": "common-envelope.schema.json#/properties/createdBy"
    },
    "classification": {
      "$ref": "common-envelope.schema.json#/properties/classification"
    },
    "provenance": {
      "$ref": "common-envelope.schema.json#/properties/provenance"
    },
    "sourceRecord": {
      "$ref": "common-envelope.schema.json#/properties/sourceRecord"
    },
    "description": {
      "$ref": "common-envelope.schema.json#/properties/description"
    },
    "scope": {
      "$ref": "common-envelope.schema.json#/properties/scope"
    },
    "effectiveTo": {
      "$ref": "common-envelope.schema.json#/properties/effectiveTo"
    },
    "modifiedAt": {
      "$ref": "common-envelope.schema.json#/properties/modifiedAt"
    },
    "modifiedBy": {
      "$ref": "common-envelope.schema.json#/properties/modifiedBy"
    },
    "distributionControlRef": {
      "$ref": "common-envelope.schema.json#/properties/distributionControlRef"
    },
    "reviewState": {
      "$ref": "common-envelope.schema.json#/properties/reviewState"
    },
    "supersedes": {
      "$ref": "common-envelope.schema.json#/properties/supersedes"
    },
    "externalIdentifiers": {
      "$ref": "common-envelope.schema.json#/properties/externalIdentifiers"
    },
    "extensions": {
      "$ref": "common-envelope.schema.json#/properties/extensions"
    },
    "nullReasons": {
      "$ref": "common-envelope.schema.json#/properties/nullReasons"
    },
    "hasUnknown": {
      "$ref": "common-envelope.schema.json#/properties/hasUnknown"
    },
    "reviewedBy": {
      "$ref": "common-envelope.schema.json#/properties/reviewedBy"
    },
    "migratedFrom": {
      "$ref": "common-envelope.schema.json#/properties/migratedFrom"
    },
    "integrationHandoff": {
      "$ref": "common-envelope.schema.json#/properties/integrationHandoff"
    },
    "governedBy": {
      "$ref": "common-envelope.schema.json#/properties/governedBy"
    },
    "evaluatesGate": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      },
      "minItems": 1
    },
    "gateCode": {
      "type": "string",
      "minLength": 1,
      "pattern": "^CG-(0[1-9]|1[0-5])$"
    },
    "gateApplicability": {
      "$ref": "definitions.schema.json#/$defs/code-GateApplicability"
    },
    "controlEvaluations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/obj-ControlEvaluation"
      }
    },
    "criteriaResults": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/obj-CriterionResult"
      }
    },
    "evidenceSufficiency": {
      "$ref": "definitions.schema.json#/$defs/code-Sufficiency"
    },
    "stateCoverage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/code-OperatingState"
      }
    },
    "gateState": {
      "$ref": "definitions.schema.json#/$defs/code-GateState"
    },
    "decisionEffect": {
      "type": "string",
      "minLength": 1
    },
    "rollupRationale": {
      "type": "string",
      "minLength": 1
    },
    "evidencedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "hasFinding": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "constrains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "summarisedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "reportedIn": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "naRationale": {
      "type": "string",
      "minLength": 1
    },
    "invalidatedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    }
  },
  "if": {
    "properties": {
      "classification": {
        "enum": [
          "CLIENT_RESTRICTED",
          "CONFIDENTIAL",
          "HIGHLY_RESTRICTED"
        ]
      }
    },
    "required": [
      "classification"
    ]
  },
  "then": {
    "required": [
      "distributionControlRef"
    ]
  }
}
