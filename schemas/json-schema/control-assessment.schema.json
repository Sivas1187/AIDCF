{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aidcf/schema/1.3/control-assessment.schema.json",
  "title": "AIDCF Control Assessment (ControlAssessment)",
  "description": "The result of assessing one control, for one claim type, in one scope: result code, confidence, evidence, method, assessor and lifecycle.",
  "x-aidcf-class": "https://w3id.org/aidcf/ontology#ControlAssessment",
  "x-aidcf-semantic-owner": "AIDCF-009",
  "x-aidcf-registration": "canonical",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "type",
    "semanticOwner",
    "schemaVersion",
    "version",
    "status",
    "releaseRef",
    "sourceArtifact",
    "name",
    "effectiveFrom",
    "createdAt",
    "createdBy",
    "classification",
    "provenance",
    "subjectRef",
    "claimType",
    "applicabilityBasis",
    "result",
    "resultRationale",
    "assessmentMethods",
    "operatingStates",
    "confidence",
    "evidenceSufficiency",
    "assessor",
    "assessedAt",
    "governedBy",
    "reviewState",
    "scope"
  ],
  "properties": {
    "@context": {
      "$ref": "common-envelope.schema.json#/properties/@context"
    },
    "id": {
      "$ref": "common-envelope.schema.json#/properties/id"
    },
    "type": {
      "const": "ControlAssessment"
    },
    "semanticOwner": {
      "$ref": "common-envelope.schema.json#/properties/semanticOwner"
    },
    "schemaVersion": {
      "$ref": "common-envelope.schema.json#/properties/schemaVersion"
    },
    "version": {
      "$ref": "common-envelope.schema.json#/properties/version"
    },
    "status": {
      "$ref": "common-envelope.schema.json#/properties/status"
    },
    "releaseRef": {
      "$ref": "common-envelope.schema.json#/properties/releaseRef"
    },
    "sourceArtifact": {
      "$ref": "common-envelope.schema.json#/properties/sourceArtifact"
    },
    "name": {
      "$ref": "common-envelope.schema.json#/properties/name"
    },
    "effectiveFrom": {
      "$ref": "common-envelope.schema.json#/properties/effectiveFrom"
    },
    "createdAt": {
      "$ref": "common-envelope.schema.json#/properties/createdAt"
    },
    "createdBy": {
      "$ref": "common-envelope.schema.json#/properties/createdBy"
    },
    "classification": {
      "$ref": "common-envelope.schema.json#/properties/classification"
    },
    "provenance": {
      "$ref": "common-envelope.schema.json#/properties/provenance"
    },
    "sourceRecord": {
      "$ref": "common-envelope.schema.json#/properties/sourceRecord"
    },
    "description": {
      "$ref": "common-envelope.schema.json#/properties/description"
    },
    "scope": {
      "$ref": "common-envelope.schema.json#/properties/scope"
    },
    "effectiveTo": {
      "$ref": "common-envelope.schema.json#/properties/effectiveTo"
    },
    "modifiedAt": {
      "$ref": "common-envelope.schema.json#/properties/modifiedAt"
    },
    "modifiedBy": {
      "$ref": "common-envelope.schema.json#/properties/modifiedBy"
    },
    "distributionControlRef": {
      "$ref": "common-envelope.schema.json#/properties/distributionControlRef"
    },
    "reviewState": {
      "$ref": "common-envelope.schema.json#/properties/reviewState"
    },
    "supersedes": {
      "$ref": "common-envelope.schema.json#/properties/supersedes"
    },
    "externalIdentifiers": {
      "$ref": "common-envelope.schema.json#/properties/externalIdentifiers"
    },
    "extensions": {
      "$ref": "common-envelope.schema.json#/properties/extensions"
    },
    "nullReasons": {
      "$ref": "common-envelope.schema.json#/properties/nullReasons"
    },
    "hasUnknown": {
      "$ref": "common-envelope.schema.json#/properties/hasUnknown"
    },
    "reviewedBy": {
      "$ref": "common-envelope.schema.json#/properties/reviewedBy"
    },
    "migratedFrom": {
      "$ref": "common-envelope.schema.json#/properties/migratedFrom"
    },
    "integrationHandoff": {
      "$ref": "common-envelope.schema.json#/properties/integrationHandoff"
    },
    "governedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "subjectRef": {
      "$ref": "definitions.schema.json#/$defs/iri"
    },
    "claimType": {
      "$ref": "definitions.schema.json#/$defs/code-ClaimType"
    },
    "applicabilityBasis": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "$ref": "definitions.schema.json#/$defs/code-ControlResult"
    },
    "resultRationale": {
      "type": "string",
      "minLength": 1
    },
    "assessmentMethods": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/code-AssessmentMethod"
      },
      "minItems": 1
    },
    "operatingStates": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/code-OperatingState"
      }
    },
    "confidence": {
      "$ref": "definitions.schema.json#/$defs/code-Confidence"
    },
    "evidenceSufficiency": {
      "$ref": "definitions.schema.json#/$defs/code-Sufficiency"
    },
    "assessor": {
      "$ref": "definitions.schema.json#/$defs/iri"
    },
    "assessedAt": {
      "$ref": "definitions.schema.json#/$defs/date"
    },
    "evidencedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "evaluatesGate": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "hasFinding": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "summarisedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    },
    "implementationMaturity": {
      "$ref": "definitions.schema.json#/$defs/code-ImplementationMaturity"
    },
    "naRationale": {
      "type": "string",
      "minLength": 1
    },
    "invalidatedBy": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "definitions.schema.json#/$defs/iri"
      }
    }
  },
  "if": {
    "properties": {
      "classification": {
        "enum": [
          "CLIENT_RESTRICTED",
          "CONFIDENTIAL",
          "HIGHLY_RESTRICTED"
        ]
      }
    },
    "required": [
      "classification"
    ]
  },
  "then": {
    "required": [
      "distributionControlRef"
    ]
  }
}
