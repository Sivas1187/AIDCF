{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://w3id.org/aidcf/schema/1.3/definitions.schema.json",
  "title": "AIDCF 1.3 shared definitions",
  "description": "Shared value definitions: IRIs, dates, controlled vocabularies (codes read from registries/vocabularies/*.csv where bound) and nested structures. Not a record schema.",
  "$defs": {
    "iri": {
      "type": "string",
      "pattern": "^(urn:[a-z0-9][a-z0-9-]*:|https://)[^\\s]+$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "code-GateRole": {
      "title": "Control-to-gate role",
      "description": "Controlled vocabulary (AIDCF-014 section 9 (EVALUATES_GATE); SPEC 6.1).",
      "type": "string",
      "enum": [
        "CRITICAL",
        "SUPPORTING"
      ]
    },
    "code-GateApplicability": {
      "title": "Gate applicability",
      "description": "Controlled vocabulary (AIDCF-014 section 8A (GateResult profile)).",
      "type": "string",
      "enum": [
