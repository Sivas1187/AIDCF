# ---------------- Structural object properties
aidcf:affectedAssertions a owl:ObjectProperty ; rdfs:label "affectedAssertions"@en ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:approvals a owl:ObjectProperty ; rdfs:label "approvals"@en ;
  skos:definition "Structured value (Approval)."@en ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:architectureBaseline a owl:ObjectProperty ; rdfs:label "architectureBaseline"@en ;
  rdfs:range aidcf:ArchitectureSnapshot ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
