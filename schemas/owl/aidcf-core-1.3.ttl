# ---------------- SKOS concept schemes (controlled vocabularies)
<https://w3id.org/aidcf/vocab/gate-role> a skos:ConceptScheme ; skos:prefLabel "Control-to-gate role"@en ; dcterms:source "AIDCF-014 section 9 (EVALUATES_GATE); SPEC 6.1" ;
  skos:hasTopConcept <https://w3id.org/aidcf/vocab/gate-role/CRITICAL>, <https://w3id.org/aidcf/vocab/gate-role/SUPPORTING> .
<https://w3id.org/aidcf/vocab/gate-role/CRITICAL> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/gate-role> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/gate-role> ; skos:notation "CRITICAL" ; skos:prefLabel "Critical"@en ; skos:definition "The gate cannot PASS unless this control is CONFORMING at its required claim type when in scope."@en .
<https://w3id.org/aidcf/vocab/gate-role/SUPPORTING> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/gate-role> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/gate-role> ; skos:notation "SUPPORTING" ; skos:prefLabel "Supporting"@en ; skos:definition "Informs the gate; a NONCONFORMING result requires a documented gate-level evaluation."@en .
<https://w3id.org/aidcf/vocab/gate-applicability> a skos:ConceptScheme ; skos:prefLabel "Gate applicability"@en ; dcterms:source "AIDCF-014 section 8A (GateResult profile)" ;
  skos:hasTopConcept <https://w3id.org/aidcf/vocab/gate-applicability/IN_SCOPE>, <https://w3id.org/aidcf/vocab/gate-applicability/APPROVED_NA> .
<https://w3id.org/aidcf/vocab/gate-applicability/IN_SCOPE> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/gate-applicability> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/gate-applicability> ; skos:notation "IN_SCOPE" ; skos:prefLabel "In scope"@en .
<https://w3id.org/aidcf/vocab/gate-applicability/APPROVED_NA> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/gate-applicability> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/gate-applicability> ; skos:notation "APPROVED_NA" ; skos:prefLabel "Approved not applicable"@en .
<https://w3id.org/aidcf/vocab/criterion-outcome> a skos:ConceptScheme ; skos:prefLabel "Gate criterion outcome"@en ; dcterms:source "AIDCF-014 section 8A (GateResult profile: criteria evaluated and outcome); AIDCF-016" ;
  skos:hasTopConcept <https://w3id.org/aidcf/vocab/criterion-outcome/MET>, <https://w3id.org/aidcf/vocab/criterion-outcome/NOT_MET>, <https://w3id.org/aidcf/vocab/criterion-outcome/UNKNOWN>, <https://w3id.org/aidcf/vocab/criterion-outcome/NOT_EVALUATED> .
<https://w3id.org/aidcf/vocab/criterion-outcome/MET> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:notation "MET" ; skos:prefLabel "Met"@en ; skos:definition "Criterion demonstrated met with evidence at or above the gate floor."@en .
<https://w3id.org/aidcf/vocab/criterion-outcome/NOT_MET> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:notation "NOT_MET" ; skos:prefLabel "Not met"@en ; skos:definition "Criterion demonstrated not met (gate FAIL)."@en .
<https://w3id.org/aidcf/vocab/criterion-outcome/UNKNOWN> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:notation "UNKNOWN" ; skos:prefLabel "Unknown"@en ; skos:definition "Criterion evaluated but cannot be determined; an UNKNOWN Record is attached."@en .
<https://w3id.org/aidcf/vocab/criterion-outcome/NOT_EVALUATED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/criterion-outcome> ; skos:notation "NOT_EVALUATED" ; skos:prefLabel "Not evaluated"@en ; skos:definition "Criterion not yet evaluated in this assessment."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle> a skos:ConceptScheme ; skos:prefLabel "Record lifecycle"@en ; dcterms:source "AIDCF-014 section 11A.1" ;
  skos:hasTopConcept <https://w3id.org/aidcf/vocab/record-lifecycle/DRAFT>, <https://w3id.org/aidcf/vocab/record-lifecycle/CANDIDATE>, <https://w3id.org/aidcf/vocab/record-lifecycle/REVIEWED>, <https://w3id.org/aidcf/vocab/record-lifecycle/APPROVED>, <https://w3id.org/aidcf/vocab/record-lifecycle/ACTIVE>, <https://w3id.org/aidcf/vocab/record-lifecycle/SUSPENDED>, <https://w3id.org/aidcf/vocab/record-lifecycle/WITHDRAWN>, <https://w3id.org/aidcf/vocab/record-lifecycle/SUPERSEDED>, <https://w3id.org/aidcf/vocab/record-lifecycle/RETIRED> .
<https://w3id.org/aidcf/vocab/record-lifecycle/DRAFT> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "DRAFT" ; skos:prefLabel "Draft"@en ; skos:definition "Being prepared; not for use in assessment."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/CANDIDATE> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "CANDIDATE" ; skos:prefLabel "Candidate"@en ; skos:definition "Proposed (often by automation); awaiting review."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/REVIEWED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "REVIEWED" ; skos:prefLabel "Reviewed"@en ; skos:definition "Reviewed; not yet approved."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/APPROVED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "APPROVED" ; skos:prefLabel "Approved"@en ; skos:definition "Approved by the accountable authority."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/ACTIVE> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "ACTIVE" ; skos:prefLabel "Active"@en ; skos:definition "Approved and in use."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/SUSPENDED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "SUSPENDED" ; skos:prefLabel "Suspended"@en ; skos:definition "Temporarily not to be relied on, pending reassessment."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/WITHDRAWN> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "WITHDRAWN" ; skos:prefLabel "Withdrawn"@en ; skos:definition "Removed from use before expiry; retained for history."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/SUPERSEDED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "SUPERSEDED" ; skos:prefLabel "Superseded"@en ; skos:definition "Replaced by a newer record (SUPERSEDES)."@en .
<https://w3id.org/aidcf/vocab/record-lifecycle/RETIRED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/record-lifecycle> ; skos:notation "RETIRED" ; skos:prefLabel "Retired"@en ; skos:definition "End of life without replacement; retained for history."@en .
<https://w3id.org/aidcf/vocab/assertion-state> a skos:ConceptScheme ; skos:prefLabel "Assertion review state"@en ; dcterms:source "AIDCF-014 section 11A.2" ;
  skos:hasTopConcept <https://w3id.org/aidcf/vocab/assertion-state/CANDIDATE>, <https://w3id.org/aidcf/vocab/assertion-state/SUPPORTED>, <https://w3id.org/aidcf/vocab/assertion-state/CHALLENGED>, <https://w3id.org/aidcf/vocab/assertion-state/QUALIFIED>, <https://w3id.org/aidcf/vocab/assertion-state/CONFLICTING>, <https://w3id.org/aidcf/vocab/assertion-state/UNKNOWN>, <https://w3id.org/aidcf/vocab/assertion-state/SUPERSEDED> .
<https://w3id.org/aidcf/vocab/assertion-state/CANDIDATE> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "CANDIDATE" ; skos:prefLabel "Candidate"@en ; skos:definition "Asserted but not reviewed."@en .
<https://w3id.org/aidcf/vocab/assertion-state/SUPPORTED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "SUPPORTED" ; skos:prefLabel "Supported"@en ; skos:definition "Reviewed; supported by evidence meeting the applicable floor."@en .
<https://w3id.org/aidcf/vocab/assertion-state/CHALLENGED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "CHALLENGED" ; skos:prefLabel "Challenged"@en ; skos:definition "Subject to an unresolved CHALLENGES edge."@en .
<https://w3id.org/aidcf/vocab/assertion-state/QUALIFIED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "QUALIFIED" ; skos:prefLabel "Qualified"@en ; skos:definition "Holds only under the conditions stated by QUALIFIES edges."@en .
<https://w3id.org/aidcf/vocab/assertion-state/CONFLICTING> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "CONFLICTING" ; skos:prefLabel "Conflicting"@en ; skos:definition "Supported and challenged by evidence of comparable quality."@en .
<https://w3id.org/aidcf/vocab/assertion-state/UNKNOWN> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "UNKNOWN" ; skos:prefLabel "Unknown"@en ; skos:definition "Cannot be determined; HAS_UNKNOWN is mandatory."@en .
<https://w3id.org/aidcf/vocab/assertion-state/SUPERSEDED> a skos:Concept ; skos:inScheme <https://w3id.org/aidcf/vocab/assertion-state> ; skos:topConceptOf <https://w3id.org/aidcf/vocab/assertion-state> ; skos:notation "SUPERSEDED" ; skos:prefLabel "Superseded"@en ; skos:definition "Replaced by a newer assertion."@en .
