# AIDCF Core Ontology 1.3 (AIDCF-016 Machine-Executable Data Model Standard)
# GENERATED by schemas/tools/build_schemas.py from schemas/tools/aidcf_model.py; do not edit by hand.
@prefix aidcf: <https://w3id.org/aidcf/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<https://w3id.org/aidcf/ontology> a owl:Ontology ;
  owl:versionIRI <https://w3id.org/aidcf/ontology/1.3> ;
  owl:versionInfo "1.3.0" ;
  rdfs:label "AIDCF Core Ontology"@en ;
  dcterms:title "AIDCF Core Ontology 1.3"@en ;
  rdfs:comment "OWL 2 ontology for the AI Data Centre Facilities Assurance Framework (AIDCF). It declares the 48 canonical classes of AIDCF-014 v1.1 section 7, the AIDCF-003 reference classes Location, PartyEntity and Component, supporting classes beyond the 48 that are pending AIDCF-014 registration (IACS, IACSZone, Conduit, SecurityLevel, FoundationalRequirement, Assertion), the auxiliary RelationshipRecord class, the 41 relationship types of AIDCF-014 v1.1 section 9 with domain, range, cardinality annotation and inverse, key datatype properties and SKOS concept schemes for the controlled vocabularies. Normative description: AIDCF-016 Machine-Executable Data Model Standard. Cardinality and mandatory-link constraints are validated with the companion SHACL shapes, not inferred. Registration of the w3id.org/aidcf redirect is pending; until it is confirmed these IRIs are identifiers only and shall not be assumed to resolve."@en ;
  dcterms:creator "Siva Sethumadhavan" ;
  dcterms:modified "2026-10-10"^^xsd:date ;
  dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
  dcterms:source "AIDCF-014 v1.1 End-to-End Traceability and Machine-Executable Data Standard; AIDCF-003 v1.1; AIDCF-002; AIDCF-016" .

aidcf:semanticOwnerArtifact a owl:AnnotationProperty ; rdfs:label "semantic owner artifact"@en ; rdfs:comment "AIDCF artifact that owns the meaning of the class."@en .
aidcf:chainStep a owl:AnnotationProperty ; rdfs:label "chain step"@en ; rdfs:comment "Step of the canonical assurance chain (AIDCF-014 section 7)."@en .
aidcf:registrationStatus a owl:AnnotationProperty ; rdfs:label "registration status"@en ; rdfs:comment "Whether the class is one of the 48 AIDCF-014 classes, an AIDCF-003 reference class, a supporting class pending registration, or auxiliary."@en .
aidcf:codeScheme a owl:AnnotationProperty ; rdfs:label "code scheme"@en ; rdfs:comment "SKOS concept scheme whose skos:notation values are the permitted literals of a coded datatype property."@en .
aidcf:relationshipCode a owl:AnnotationProperty ; rdfs:label "relationship code"@en ; rdfs:comment "AIDCF-014 section 9 relationship type code realised by an object property."@en .
aidcf:cardinalityOut a owl:AnnotationProperty ; rdfs:label "cardinality out"@en ; rdfs:comment "AIDCF-014 section 9 cardinality per source instance (validated by SHACL)."@en .
aidcf:cardinalityIn a owl:AnnotationProperty ; rdfs:label "cardinality in"@en ; rdfs:comment "AIDCF-014 section 9 cardinality per target instance (validated by SHACL)."@en .
aidcf:qualifierProperty a owl:AnnotationProperty ; rdfs:label "qualifier property"@en ; rdfs:comment "Relationship-envelope qualifier mandatory for this relationship type (AIDCF-014 section 10)."@en .

# ---------------- Abstract superclasses
aidcf:AidcfRecord a owl:Class ; rdfs:subClassOf prov:Entity ;
  rdfs:label "Enveloped record"@en ; skos:definition "Any AIDCF record carrying the common object envelope (AIDCF-014 section 8)."@en .
aidcf:GovernanceRecord a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Governance record"@en ; skos:definition "Release, baseline, programme, validation, migration and distribution records."@en .
aidcf:CapabilityElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Capability element"@en ; skos:definition "Capability, outcome and function records (chain steps 2 to 4)."@en .
aidcf:ArchitectureRecord a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Architecture record"@en ; skos:definition "Architecture, dependency, fault-domain, state and capacity records (chain steps 5 and 6)."@en .
aidcf:ArchitectureElement a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Architecture element"@en ; skos:definition "InfrastructureSystem, AssetInstance, Interface or Resource (AIDCF-014 section 9 conventions)."@en .
aidcf:FailureRecord a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Failure record"@en ; skos:definition "Adverse conditions, failure scenarios and safeguards (chain steps 7 and 8)."@en .
aidcf:AdverseCondition a owl:Class ; rdfs:subClassOf aidcf:FailureRecord ;
  rdfs:label "Adverse condition"@en ; skos:definition "Common superclass of Threat, Hazard and FailureMode."@en .
aidcf:ControlFrameworkElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Control framework element"@en ; skos:definition "Domains, families, controls and critical gates."@en .
aidcf:EvidenceElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Evidence element"@en ; skos:definition "Evidence requirements, objects and packages (chain steps 10 and 11)."@en .
aidcf:AssessmentElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Assessment element"@en ; skos:definition "Assessments, procedures, samples, tests and control assessments (chain step 12)."@en .
aidcf:AssuranceChallenge a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Assurance challenge"@en ; skos:definition "Findings and UNKNOWN Records (chain step 13)."@en .
aidcf:DecisionElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Decision element"@en ; skos:definition "Gate results, scores, recommendations, reviews and decisions (chain steps 14 to 16)."@en .
aidcf:ReportingElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Reporting element"@en ; skos:definition "Statements and reports."@en .
aidcf:ContinuingAssuranceElement a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Continuing assurance element"@en ; skos:definition "Actions, triggers, events and handoffs that close the loop."@en .
aidcf:ReferenceEntity a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Reference entity"@en ; skos:definition "AIDCF-003 reference classes used in AIDCF-014 relationship ranges."@en .
aidcf:SupportingRecord a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Supporting record"@en ; skos:definition "Supporting classes beyond the 48 canonical classes, pending AIDCF-014 registration."@en .

# ---------------- The 48 canonical classes (AIDCF-014 v1.1 section 7)
aidcf:ReleaseManifest a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Release Manifest"@en ; skos:definition "Signed, immutable bill of materials pinning every artifact, registry, vocabulary, schema and ontology version of one release."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .
aidcf:BaselineIssue a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Baseline Issue"@en ; skos:definition "Recorded conflict between pinned sources, with original values, status and resolution lineage."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .
aidcf:CapabilityInstance a owl:Class ; rdfs:subClassOf aidcf:CapabilityElement ;
  rdfs:label "Capability Instance"@en ; skos:definition "A specific deployment of an AI capability bounded by ownership, location, architecture, capacity, criticality and obligations."@en ; aidcf:chainStep "2" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:ServiceOutcome a owl:Class ; rdfs:subClassOf aidcf:CapabilityElement ;
  rdfs:label "Service Outcome"@en ; skos:definition "A measurable or assessable result the CapabilityInstance must achieve, with tolerance, duration and operating-state conditions."@en ; aidcf:chainStep "3" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:RequiredFunction a owl:Class ; rdfs:subClassOf aidcf:CapabilityElement ;
  rdfs:label "Required Function"@en ; skos:definition "A function whose loss or degradation materially affects one or more ServiceOutcomes (for example \"remove 100% of rack heat at design inlet temperature\")."@en ; aidcf:chainStep "4" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:ArchitectureSnapshot a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Architecture Snapshot"@en ; skos:definition "A versioned, approved and immutable view of the architecture in scope at a point in time, against which assessments are performed."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-013" ; aidcf:registrationStatus "canonical" .
aidcf:InfrastructureSystem a owl:Class ; rdfs:subClassOf aidcf:ArchitectureElement ;
  rdfs:label "Infrastructure System"@en ; skos:definition "A coordinated set of assets and interfaces providing one or more functions (for example a CDU secondary loop, a UPS system, a scale-out fabric)."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:AssetInstance a owl:Class ; rdfs:subClassOf aidcf:ArchitectureElement ;
  rdfs:label "Asset Instance"@en ; skos:definition "An identifiable real-world item, service, procedure or resource provider represented where material (for example a switchboard, a CDU, a GPU node)."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:Interface a owl:Class ; rdfs:subClassOf aidcf:ArchitectureElement ;
  rdfs:label "Interface"@en ; skos:definition "A defined point or mechanism of exchange between entities (electrical, thermal, fluid, network, management, data, physical, operational, provider)."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:Resource a owl:Class ; rdfs:subClassOf aidcf:ArchitectureElement ;
  rdfs:label "Resource"@en ; skos:definition "A consumable or constrained input required for operation (electrical capacity, cooling capacity, water, fuel, rack space, accelerator hours)."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:Dependency a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Dependency"@en ; skos:definition "A reified reliance of one entity on another entity, resource, condition or decision, with direction, strength, states and substitutability."@en ; aidcf:chainStep "6" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:FaultDomain a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Fault Domain"@en ; skos:definition "A set of entities expected to be affected together by a common cause of failure, with its boundary and blast radius."@en ; aidcf:chainStep "6" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:OperatingState a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Operating State"@en ; skos:definition "A defined condition of operation (NORMAL, DEGRADED, MAINTENANCE, EMERGENCY, RECOVERY, TRANSITION, SHUTDOWN, FAILED, UNKNOWN)."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:CapacityAssertion a owl:Class ; rdfs:subClassOf aidcf:ArchitectureRecord ;
  rdfs:label "Capacity Assertion"@en ; skos:definition "A conditioned claim about a capacity value: metric, unit, subject, operating state, environment, duration, derating, evidence date and confidence."@en ; aidcf:chainStep "5" ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "canonical" .
aidcf:Threat a owl:Class ; rdfs:subClassOf aidcf:AdverseCondition ;
  rdfs:label "Threat"@en ; skos:definition "An actor-driven or intentional source of potential harm (for example unauthorised remote command of a cooling controller)."@en ; aidcf:chainStep "7" ;
  aidcf:semanticOwnerArtifact "AIDCF-004" ; aidcf:registrationStatus "canonical" .
aidcf:Hazard a owl:Class ; rdfs:subClassOf aidcf:AdverseCondition ;
  rdfs:label "Hazard"@en ; skos:definition "A non-intentional source of potential harm (for example utility voltage sag, coolant leak, heatwave, battery thermal runaway)."@en ; aidcf:chainStep "7" ;
  aidcf:semanticOwnerArtifact "AIDCF-004" ; aidcf:registrationStatus "canonical" .
aidcf:FailureMode a owl:Class ; rdfs:subClassOf aidcf:AdverseCondition ;
  rdfs:label "Failure Mode"@en ; skos:definition "The manner in which an entity fails to perform its function (for example pump seizure, breaker failure to trip, optic degradation)."@en ; aidcf:chainStep "7" ;
  aidcf:semanticOwnerArtifact "AIDCF-004" ; aidcf:registrationStatus "canonical" .
aidcf:FailureScenario a owl:Class ; rdfs:subClassOf aidcf:FailureRecord ;
  rdfs:label "Failure Scenario"@en ; skos:definition "An ordered path from initiating source through propagation steps and safeguards to residual state and outcome effect, from a stated pre-state."@en ; aidcf:chainStep "7" ;
  aidcf:semanticOwnerArtifact "AIDCF-004" ; aidcf:registrationStatus "canonical" .
aidcf:Safeguard a owl:Class ; rdfs:subClassOf aidcf:FailureRecord ;
  rdfs:label "Safeguard"@en ; skos:definition "A real-world measure that prevents, detects, contains, corrects or recovers from a failure, threat or hazard."@en ; aidcf:chainStep "8" ;
  aidcf:semanticOwnerArtifact "AIDCF-004" ; aidcf:registrationStatus "canonical" .
aidcf:ControlDomain a owl:Class ; rdfs:subClassOf aidcf:ControlFrameworkElement ;
  rdfs:label "Control Domain"@en ; skos:definition "One of the 15 AIDCF-007A control domains."@en ; aidcf:chainStep "9" ;
  aidcf:semanticOwnerArtifact "AIDCF-007A" ; aidcf:registrationStatus "canonical" .
aidcf:ControlFamily a owl:Class ; rdfs:subClassOf aidcf:ControlFrameworkElement ;
  rdfs:label "Control Family"@en ; skos:definition "One of the 90 AIDCF-007A control families (six per domain)."@en ; aidcf:chainStep "9" ;
  aidcf:semanticOwnerArtifact "AIDCF-007A" ; aidcf:registrationStatus "canonical" .
aidcf:Control a owl:Class ; rdfs:subClassOf aidcf:ControlFrameworkElement ;
  rdfs:label "Control"@en ; skos:definition "One of the 360 AIDCF-007A normative controls: objective, requirement, criteria, evidence profile, procedure and gate mappings."@en ; aidcf:chainStep "9" ;
  aidcf:semanticOwnerArtifact "AIDCF-007A" ; aidcf:registrationStatus "canonical" .
aidcf:EvidenceRequirement a owl:Class ; rdfs:subClassOf aidcf:EvidenceElement ;
  rdfs:label "Evidence Requirement"@en ; skos:definition "The evidence a control or gate needs for a claim type: classes, quality and sufficiency floors, state and period coverage, independence."@en ; aidcf:chainStep "10" ;
  aidcf:semanticOwnerArtifact "AIDCF-008" ; aidcf:registrationStatus "canonical" .
aidcf:EvidenceObject a owl:Class ; rdfs:subClassOf aidcf:EvidenceElement ;
  rdfs:label "Evidence Object"@en ; skos:definition "A record or observation, with provenance and integrity, used to support, challenge or qualify an assertion."@en ; aidcf:chainStep "11" ;
  aidcf:semanticOwnerArtifact "AIDCF-008" ; aidcf:registrationStatus "canonical" .
aidcf:EvidencePackage a owl:Class ; rdfs:subClassOf aidcf:EvidenceElement ;
  rdfs:label "Evidence Package"@en ; skos:definition "A sealed, manifest-listed set of EvidenceObjects collected for an assessment or gate, with custody and integrity metadata."@en ; aidcf:chainStep "11" ;
  aidcf:semanticOwnerArtifact "AIDCF-008" ; aidcf:registrationStatus "canonical" .
aidcf:AssuranceProgram a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Assurance Program"@en ; skos:definition "The programme within which assessments are planned and decisions issued: assurance level target, profile, cadence and authority."@en ; aidcf:chainStep "1" ;
  aidcf:semanticOwnerArtifact "AIDCF-011" ; aidcf:registrationStatus "canonical" .
aidcf:Assessment a owl:Class ; rdfs:subClassOf aidcf:AssessmentElement ;
  rdfs:label "Assessment"@en ; skos:definition "One bounded assessment answering one decision question for one CapabilityInstance, scope and ArchitectureSnapshot."@en ; aidcf:chainStep "1, 12" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:AssessmentProcedure a owl:Class ; rdfs:subClassOf aidcf:AssessmentElement ;
  rdfs:label "Assessment Procedure"@en ; skos:definition "The ordered method steps used to assess one control for one claim type, using canonical assessment methods."@en ; aidcf:chainStep "12" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:Sample a owl:Class ; rdfs:subClassOf aidcf:AssessmentElement ;
  rdfs:label "Sample"@en ; skos:definition "A defined selection of population items examined by a procedure, with population, selection method and size rationale."@en ; aidcf:chainStep "12" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:TestRecord a owl:Class ; rdfs:subClassOf aidcf:AssessmentElement ;
  rdfs:label "Test Record"@en ; skos:definition "The record of an authorised test or scenario exercise: authority, preconditions, safety controls, steps, observations and outcome."@en ; aidcf:chainStep "12" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:ControlAssessment a owl:Class ; rdfs:subClassOf aidcf:AssessmentElement ;
  rdfs:label "Control Assessment"@en ; skos:definition "The result of assessing one control, for one claim type, in one scope: result code, confidence, evidence, method, assessor and lifecycle."@en ; aidcf:chainStep "12" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:Finding a owl:Class ; rdfs:subClassOf aidcf:AssuranceChallenge ;
  rdfs:label "Finding"@en ; skos:definition "A documented deficiency against a stated criterion, with condition, cause, consequence, evidence and gate and score effect."@en ; aidcf:chainStep "13" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:UnknownRecord a owl:Class ; rdfs:subClassOf aidcf:AssuranceChallenge ;
  rdfs:label "UNKNOWN Record"@en ; skos:definition "A material fact that cannot be determined, with type (U1–U10), severity (US1–US5), reason, decision effect, evidence needed and owner."@en ; aidcf:chainStep "13" ;
  aidcf:semanticOwnerArtifact "AIDCF-008" ; aidcf:registrationStatus "canonical" .
aidcf:CriticalGate a owl:Class ; rdfs:subClassOf aidcf:ControlFrameworkElement ;
  rdfs:label "Critical Gate"@en ; skos:definition "One of the 15 non-compensating critical gates CG-01 to CG-15, with scope, criteria and evidence floor."@en ; aidcf:chainStep "14" ;
  aidcf:semanticOwnerArtifact "AIDCF-010" ; aidcf:registrationStatus "canonical" .
aidcf:GateResult a owl:Class ; rdfs:subClassOf aidcf:DecisionElement ;
  rdfs:label "Gate Result"@en ; skos:definition "The evaluated status of one CriticalGate in one assessment scope (PASS, FAIL, UNKNOWN, APPROVED_NA, NOT_ASSESSED) with its inputs."@en ; aidcf:chainStep "14" ;
  aidcf:semanticOwnerArtifact "AIDCF-010" ; aidcf:registrationStatus "canonical" .
aidcf:ScoreSnapshot a owl:Class ; rdfs:subClassOf aidcf:DecisionElement ;
  rdfs:label "Score Snapshot"@en ; skos:definition "An immutable, reproducible computation of control, family and domain scores, coverage and band from pinned inputs and profile."@en ; aidcf:chainStep "15" ;
  aidcf:semanticOwnerArtifact "AIDCF-010" ; aidcf:registrationStatus "canonical" .
aidcf:DecisionRecommendation a owl:Class ; rdfs:subClassOf aidcf:DecisionElement ;
  rdfs:label "Decision Recommendation"@en ; skos:definition "The decision state, conditions, ceilings and limitations proposed from gate results, UNKNOWNs and scores, before authority review."@en ; aidcf:chainStep "15" ;
  aidcf:semanticOwnerArtifact "AIDCF-010" ; aidcf:registrationStatus "canonical" .
aidcf:ReviewRecord a owl:Class ; rdfs:subClassOf aidcf:DecisionElement ;
  rdfs:label "Review Record"@en ; skos:definition "A recorded human review or approval: reviewer, authority, independence, scope reviewed, outcome and date."@en ; aidcf:chainStep "16" ;
  aidcf:semanticOwnerArtifact "AIDCF-009" ; aidcf:registrationStatus "canonical" .
aidcf:AssuranceDecision a owl:Class ; rdfs:subClassOf aidcf:DecisionElement ;
  rdfs:label "Assurance Decision"@en ; skos:definition "The decision of the accountable authority: decision state, conditions, scope, validity period and lifecycle."@en ; aidcf:chainStep "16" ;
  aidcf:semanticOwnerArtifact "AIDCF-010" ; aidcf:registrationStatus "canonical" .
aidcf:AssuranceStatement a owl:Class ; rdfs:subClassOf aidcf:ReportingElement ;
  rdfs:label "Assurance Statement"@en ; skos:definition "The bounded, disclosed wording of an AssuranceDecision for a named audience, which cannot exceed the decision."@en ; aidcf:chainStep "Loop" ;
  aidcf:semanticOwnerArtifact "AIDCF-012" ; aidcf:registrationStatus "canonical" .
aidcf:AssuranceReport a owl:Class ; rdfs:subClassOf aidcf:ReportingElement ;
  rdfs:label "Assurance Report"@en ; skos:definition "The issued report carrying statements, scope, findings, UNKNOWNs, limitations, distribution and validity."@en ; aidcf:chainStep "Loop" ;
  aidcf:semanticOwnerArtifact "AIDCF-012" ; aidcf:registrationStatus "canonical" .
aidcf:Action a owl:Class ; rdfs:subClassOf aidcf:ContinuingAssuranceElement ;
  rdfs:label "Action"@en ; skos:definition "A remediation, evidence-collection or condition-fulfilment task with owner, due date and closure criteria."@en ; aidcf:chainStep "Loop" ;
  aidcf:semanticOwnerArtifact "AIDCF-011" ; aidcf:registrationStatus "canonical" .
aidcf:ReassessmentTrigger a owl:Class ; rdfs:subClassOf aidcf:ContinuingAssuranceElement ;
  rdfs:label "Reassessment Trigger"@en ; skos:definition "A declared rule describing which events or conditions require reassessment of which records."@en ; aidcf:chainStep "Loop" ;
  aidcf:semanticOwnerArtifact "AIDCF-011" ; aidcf:registrationStatus "canonical" .
aidcf:Event a owl:Class ; rdfs:subClassOf aidcf:ContinuingAssuranceElement ;
  rdfs:label "Event"@en ; skos:definition "An observed or reported occurrence (change, incident, test failure, evidence expiry) ingested for impact analysis."@en ; aidcf:chainStep "Loop" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .
aidcf:IntegrationHandoff a owl:Class ; rdfs:subClassOf aidcf:ContinuingAssuranceElement ;
  rdfs:label "Integration Handoff"@en ; skos:definition "A reviewed exchange of identity or findings between AIDCF and the AI Trust Graph, preserving each framework's ownership."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-005" ; aidcf:registrationStatus "canonical" .
aidcf:ValidationResult a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Validation Result"@en ; skos:definition "The outcome of a structural, semantic or business-rule validation of a record or package against a pinned release."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .
aidcf:MigrationRecord a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Migration Record"@en ; skos:definition "The record of converting data between versions or vocabularies: source, target, rule, mapping, exceptions and validation."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .
aidcf:DistributionControl a owl:Class ; rdfs:subClassOf aidcf:GovernanceRecord ;
  rdfs:label "Distribution Control"@en ; skos:definition "The classification-bound disclosure rule for a record, edge, package or report: permitted audiences, purpose, redaction and expiry."@en ; aidcf:chainStep "Context" ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "canonical" .

# ---------------- AIDCF-003 reference classes (AIDCF-014 v1.1 section 7, reference classes)
aidcf:Location a owl:Class ; rdfs:subClassOf aidcf:ReferenceEntity ;
  rdfs:label "Location"@en ; skos:definition "A site, building, hall, room, row, rack position or logical placement."@en ; rdfs:comment "AIDCF-014 v1.1 section 7 reference class (range of LOCATED_IN)."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "reference" .
aidcf:PartyEntity a owl:Class ; rdfs:subClassOf aidcf:ReferenceEntity ;
  rdfs:label "Party Entity"@en ; skos:definition "An organisation, role, actor or team."@en ; rdfs:comment "AIDCF-014 v1.1 section 7 reference class (range of OPERATED_BY, CONTROLLED_BY, DEPENDS_ON)."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "reference" .
aidcf:Component a owl:Class ; rdfs:subClassOf aidcf:ReferenceEntity ;
  rdfs:label "Component"@en ; skos:definition "A constituent part of an asset represented where material."@en ; rdfs:comment "AIDCF-014 v1.1 section 7 reference class (range of COMPOSED_OF)."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "reference" .

# ---------------- Supporting classes beyond the 48 canonical classes, pending AIDCF-014 registration
aidcf:IACS a owl:Class ; rdfs:subClassOf aidcf:InfrastructureSystem ;
  rdfs:label "Industrial Automation and Control System"@en ; skos:definition "Industrial Automation and Control System: the personnel, hardware, software and policies that operate, monitor and protect a physical process. In AIDCF, the control systems of power, cooling, fire and building services, including their engineering workstations, historians and gateways. Subclass of InfrastructureSystem."@en ; rdfs:comment "AIDCF-003 v1.1 section 72; supporting class beyond the 48 canonical classes, pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "supporting" .
aidcf:IACSZone a owl:Class ; rdfs:subClassOf aidcf:InfrastructureSystem ;
  rdfs:label "IACS Zone"@en ; skos:definition "A grouping of logical or physical assets that share common security requirements, defined through a security risk assessment (IEC 62443-3-2). Distinct from a physical security zone (AIDCF-003)."@en ; rdfs:comment "AIDCF-003 v1.1 section 72; mapped by AIDCF-003 to an InfrastructureSystem grouping; supporting class pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "supporting" .
aidcf:Conduit a owl:Class ; rdfs:subClassOf aidcf:Interface ;
  rdfs:label "Conduit"@en ; skos:definition "A logical grouping of communication channels connecting two or more zones that share common security requirements (IEC 62443-3-2)."@en ; rdfs:comment "AIDCF-003 v1.1 section 72; mapped by AIDCF-003 to an Interface; supporting class pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "supporting" .
aidcf:SecurityLevel a owl:Class ; rdfs:subClassOf aidcf:SupportingRecord ;
  rdfs:label "Security Level"@en ; skos:definition "A level 0 to 4 expressing the protection a zone, conduit or component provides against increasingly capable violation, recorded per foundational requirement as a seven-element vector. Kinds: SL-T (target), SL-C (capability), SL-A (achieved)."@en ; rdfs:comment "AIDCF-003 v1.1 section 72; supporting class pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "supporting" .
aidcf:FoundationalRequirement a owl:Class ; rdfs:subClassOf aidcf:SupportingRecord ;
  rdfs:label "Foundational Requirement"@en ; skos:definition "One of the seven IEC 62443 foundational requirements against which security levels are expressed (FR1 to FR7)."@en ; rdfs:comment "AIDCF-003 v1.1 section 72; supporting class pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-003" ; aidcf:registrationStatus "supporting" .
aidcf:Assertion a owl:Class ; rdfs:subClassOf aidcf:SupportingRecord ;
  rdfs:label "Assertion"@en ; skos:definition "A precise testable proposition to which evidence is attached (AIDCF-002 section 19.4); expressed as subject, predicate and object or value with scope, conditions and effective time (AIDCF-003 v1.1)."@en ; rdfs:comment "AIDCF-002 class; not among the AIDCF-014 v1.1 48 classes; supporting class pending AIDCF-014 registration."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-002" ; aidcf:registrationStatus "supporting" .

# ---------------- Auxiliary structural class
aidcf:RelationshipRecord a owl:Class ; rdfs:subClassOf aidcf:AidcfRecord ;
  rdfs:label "Relationship Record"@en ; skos:definition "Auxiliary structural class (not one of the 48 classes) carrying the AIDCF-014 section 10 relationship envelope for one asserted edge."@en ; rdfs:comment "AIDCF-014 section 10."@en ;
  aidcf:semanticOwnerArtifact "AIDCF-014" ; aidcf:registrationStatus "auxiliary" .

# ---------------- Disjointness
[] a owl:AllDisjointClasses ; owl:members ( aidcf:Threat aidcf:Hazard aidcf:FailureMode ) .
[] a owl:AllDisjointClasses ; owl:members ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource ) .
[] a owl:AllDisjointClasses ; owl:members ( aidcf:Finding aidcf:UnknownRecord ) .
[] a owl:AllDisjointClasses ; owl:members ( aidcf:GateResult aidcf:ScoreSnapshot aidcf:DecisionRecommendation aidcf:ReviewRecord aidcf:AssuranceDecision ) .

# ---------------- Relationship object properties (AIDCF-014 v1.1 section 9, 41 types)
aidcf:hasOutcome a owl:ObjectProperty ;
  rdfs:label "HAS_OUTCOME"@en ; skos:definition "The capability instance is required to achieve the target service outcome."@en ; aidcf:relationshipCode "HAS_OUTCOME" ;
  aidcf:cardinalityOut "1..*" ; aidcf:cardinalityIn "1..1" ;
  rdfs:domain aidcf:CapabilityInstance ;
  rdfs:range aidcf:ServiceOutcome ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:requiresFunction a owl:ObjectProperty ;
  rdfs:label "REQUIRES_FUNCTION"@en ; skos:definition "Achieving the outcome requires the target function to be delivered."@en ; aidcf:relationshipCode "REQUIRES_FUNCTION" ;
  aidcf:cardinalityOut "1..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain aidcf:ServiceOutcome ;
  rdfs:range aidcf:RequiredFunction ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:implementedBy a owl:ObjectProperty ;
  rdfs:label "IMPLEMENTED_BY"@en ; skos:definition "The function, or the safeguard, is realised by the target architecture element."@en ; aidcf:relationshipCode "IMPLEMENTED_BY" ;
  aidcf:cardinalityOut "1..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:RequiredFunction aidcf:Safeguard ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:composedOf a owl:ObjectProperty ;
  rdfs:label "COMPOSED_OF"@en ; skos:definition "Whole-part structure: the source contains the target as a constituent. Acyclic."@en ; aidcf:relationshipCode "COMPOSED_OF" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:ArchitectureSnapshot aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:ControlDomain aidcf:ControlFamily aidcf:AssuranceProgram aidcf:Assessment aidcf:EvidencePackage ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Component aidcf:Interface aidcf:Resource aidcf:ControlFamily aidcf:Control aidcf:Assessment aidcf:ControlAssessment aidcf:GateResult aidcf:Sample aidcf:TestRecord aidcf:EvidenceObject ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:connectsTo a owl:ObjectProperty ;
  rdfs:label "CONNECTS_TO"@en ; skos:definition "The source is an endpoint of the target interface. Physical or logical connection only; implies no dependency, causality or reachability."@en ; aidcf:relationshipCode "CONNECTS_TO" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "2..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance ) ] ;
  rdfs:range aidcf:Interface ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:consumesResource a owl:ObjectProperty ;
  rdfs:label "CONSUMES_RESOURCE"@en ; skos:definition "The source draws on the target constrained resource (power, cooling, water, fuel, space, accelerator capacity)."@en ; aidcf:relationshipCode "CONSUMES_RESOURCE" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:RequiredFunction aidcf:InfrastructureSystem aidcf:AssetInstance ) ] ;
  rdfs:range aidcf:Resource ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:dependsOn a owl:ObjectProperty ;
  rdfs:label "DEPENDS_ON"@en ; skos:definition "The source relies on the target to perform its function; each edge references exactly one Dependency record carrying type, strength and states."@en ; aidcf:relationshipCode "DEPENDS_ON" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  aidcf:qualifierProperty aidcf:dependencyRef ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:RequiredFunction aidcf:Safeguard aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard aidcf:PartyEntity ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:sharesFaultDomainWith a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "SHARES_FAULT_DOMAIN_WITH"@en ; skos:definition "Source and target are members of the same FaultDomain and can fail together from its common cause. Symmetric; each edge references the FaultDomain record."@en ; aidcf:relationshipCode "SHARES_FAULT_DOMAIN_WITH" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  aidcf:qualifierProperty aidcf:faultDomainRef ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:locatedIn a owl:ObjectProperty ;
  rdfs:label "LOCATED_IN"@en ; skos:definition "The source is physically or logically placed in the target location."@en ; aidcf:relationshipCode "LOCATED_IN" ;
  aidcf:cardinalityOut "0..1" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:FaultDomain ) ] ;
  rdfs:range aidcf:Location ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:operatedBy a owl:ObjectProperty ;
  rdfs:label "OPERATED_BY"@en ; skos:definition "The target party holds operational responsibility for the source."@en ; aidcf:relationshipCode "OPERATED_BY" ;
  aidcf:cardinalityOut "1..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:CapabilityInstance aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Safeguard ) ] ;
  rdfs:range aidcf:PartyEntity ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:controlledBy a owl:ObjectProperty ;
  rdfs:label "CONTROLLED_BY"@en ; skos:definition "The target control system or actor can command the source's state or setpoints."@en ; aidcf:relationshipCode "CONTROLLED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:PartyEntity ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:monitoredBy a owl:ObjectProperty ;
  rdfs:label "MONITORED_BY"@en ; skos:definition "The target observes the source and is relied on to detect its condition."@en ; aidcf:relationshipCode "MONITORED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard aidcf:Dependency ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:protectedBy a owl:ObjectProperty ;
  rdfs:label "PROTECTED_BY"@en ; skos:definition "The target safeguard acts to prevent, detect, contain, correct or recover from failure of, or harm to, the source."@en ; aidcf:relationshipCode "PROTECTED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:ServiceOutcome aidcf:RequiredFunction aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource ) ] ;
  rdfs:range aidcf:Safeguard ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:exposedTo a owl:ObjectProperty ;
  rdfs:label "EXPOSED_TO"@en ; skos:definition "The source is credibly susceptible to the target threat, hazard or failure mode."@en ; aidcf:relationshipCode "EXPOSED_TO" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:CapabilityInstance aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:Threat aidcf:Hazard aidcf:FailureMode ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:initiates a owl:ObjectProperty ;
  rdfs:label "INITIATES"@en ; skos:definition "The threat, hazard or failure mode is the initiating source of the target scenario."@en ; aidcf:relationshipCode "INITIATES" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Threat aidcf:Hazard aidcf:FailureMode ) ] ;
  rdfs:range aidcf:FailureScenario ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:propagatesTo a owl:ObjectProperty ;
  rdfs:label "PROPAGATES_TO"@en ; skos:definition "Within a named scenario, failure of the source causes failure or degradation of the target; carries scenarioRef and step ordinal."@en ; aidcf:relationshipCode "PROPAGATES_TO" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  aidcf:qualifierProperty aidcf:scenarioRef ;
  aidcf:qualifierProperty aidcf:stepOrdinal ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:RequiredFunction ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:RequiredFunction aidcf:ServiceOutcome ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:recoversThrough a owl:ObjectProperty ;
  rdfs:label "RECOVERS_THROUGH"@en ; skos:definition "The source is restored to tolerance by means of the target recovery path, alternate capacity or recovery safeguard."@en ; aidcf:relationshipCode "RECOVERS_THROUGH" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:ServiceOutcome aidcf:RequiredFunction aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:InfrastructureSystem aidcf:AssetInstance aidcf:Interface aidcf:Resource aidcf:Safeguard ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:governedBy a owl:ObjectProperty ;
  rdfs:label "GOVERNED_BY"@en ; skos:definition "The source is subject to the requirements, method or disclosure rule of the target."@en ; aidcf:relationshipCode "GOVERNED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:Control aidcf:AssessmentProcedure aidcf:AssuranceProgram aidcf:DistributionControl ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:hasEvidenceRequirement a owl:ObjectProperty ;
  rdfs:label "HAS_EVIDENCE_REQUIREMENT"@en ; skos:definition "The control or gate requires the target evidence requirement for a stated claim type."@en ; aidcf:relationshipCode "HAS_EVIDENCE_REQUIREMENT" ;
  aidcf:cardinalityOut "1..*" ; aidcf:cardinalityIn "1..1" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Control aidcf:CriticalGate ) ] ;
  rdfs:range aidcf:EvidenceRequirement ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:evidencedBy a owl:ObjectProperty ;
  rdfs:label "EVIDENCED_BY"@en ; skos:definition "The source is offered the target evidence. Records that evidence was presented, not that it is sufficient."@en ; aidcf:relationshipCode "EVIDENCED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:EvidenceRequirement aidcf:CapacityAssertion aidcf:Dependency aidcf:FaultDomain aidcf:ControlAssessment aidcf:GateResult aidcf:Finding ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:EvidenceObject aidcf:EvidencePackage ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:supports a owl:ObjectProperty ;
  rdfs:label "SUPPORTS"@en ; skos:definition "After review, the source evidence corroborates the target claim."@en ; aidcf:relationshipCode "SUPPORTS" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain aidcf:EvidenceObject ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:CapacityAssertion aidcf:Dependency aidcf:FaultDomain aidcf:ControlAssessment aidcf:GateResult aidcf:FailureScenario ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:challenges a owl:ObjectProperty ;
  rdfs:label "CHALLENGES"@en ; skos:definition "The source contradicts or undermines the target claim (defeater). Alias: DISPUTES."@en ; aidcf:relationshipCode "CHALLENGES" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:EvidenceObject aidcf:Finding aidcf:UnknownRecord aidcf:ReviewRecord aidcf:BaselineIssue ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:CapacityAssertion aidcf:Dependency aidcf:FaultDomain aidcf:ControlAssessment aidcf:GateResult aidcf:FailureScenario aidcf:Finding aidcf:UnknownRecord aidcf:Event aidcf:Assertion aidcf:SecurityLevel aidcf:RelationshipRecord ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:qualifies a owl:ObjectProperty ;
  rdfs:label "QUALIFIES"@en ; skos:definition "The source limits the scope, states or conditions under which the target claim holds, without contradicting it."@en ; aidcf:relationshipCode "QUALIFIES" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:EvidenceObject aidcf:ReviewRecord aidcf:UnknownRecord ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:CapacityAssertion aidcf:Dependency aidcf:FaultDomain aidcf:ControlAssessment aidcf:GateResult aidcf:FailureScenario aidcf:Finding aidcf:UnknownRecord aidcf:Event aidcf:Assertion aidcf:SecurityLevel aidcf:RelationshipRecord ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:assessedBy a owl:ObjectProperty ;
  rdfs:label "ASSESSED_BY"@en ; skos:definition "The control is assessed, for one claim type in one scope, by the target control assessment."@en ; aidcf:relationshipCode "ASSESSED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..1" ;
  rdfs:domain aidcf:Control ;
  rdfs:range aidcf:ControlAssessment ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:resultsIn a owl:ObjectProperty ;
  rdfs:label "RESULTS_IN"@en ; skos:definition "Execution of the procedure, sample or test produced (contributes to) the target control assessment."@en ; aidcf:relationshipCode "RESULTS_IN" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:AssessmentProcedure aidcf:Sample aidcf:TestRecord ) ] ;
  rdfs:range aidcf:ControlAssessment ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:hasFinding a owl:ObjectProperty ;
  rdfs:label "HAS_FINDING"@en ; skos:definition "The source result or gate evaluation records the target finding."@en ; aidcf:relationshipCode "HAS_FINDING" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:ControlAssessment aidcf:GateResult aidcf:Assessment ) ] ;
  rdfs:range aidcf:Finding ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:hasUnknown a owl:ObjectProperty ;
  rdfs:label "HAS_UNKNOWN"@en ; skos:definition "The source has a material undetermined fact recorded by the target UNKNOWN record."@en ; aidcf:relationshipCode "HAS_UNKNOWN" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:range aidcf:UnknownRecord ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:evaluatesGate a owl:ObjectProperty ;
  rdfs:label "EVALUATES_GATE"@en ; skos:definition "Control to CriticalGate: registry gate mapping, mandatory attribute gateRole (CRITICAL or SUPPORTING). ControlAssessment to GateResult: the result is an input to that gate evaluation. GateResult to CriticalGate: the result evaluates that gate."@en ; aidcf:relationshipCode "EVALUATES_GATE" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Control aidcf:ControlAssessment aidcf:GateResult ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:CriticalGate aidcf:GateResult ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:constrains a owl:ObjectProperty ;
  rdfs:label "CONSTRAINS"@en ; skos:definition "The source imposes a ceiling, condition, limitation or band withholding on the target. Attribute constraintType: CEILING, CONDITION, LIMITATION, BAND_WITHHELD, GATE_EFFECT."@en ; aidcf:relationshipCode "CONSTRAINS" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  aidcf:qualifierProperty aidcf:constraintType ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:GateResult aidcf:UnknownRecord aidcf:Finding ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:GateResult aidcf:ScoreSnapshot aidcf:DecisionRecommendation aidcf:AssuranceDecision aidcf:AssuranceStatement ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:summarisedBy a owl:ObjectProperty ;
  rdfs:label "SUMMARISED_BY"@en ; skos:definition "The source results are aggregated into the target score snapshot or recommendation."@en ; aidcf:relationshipCode "SUMMARISED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:ControlAssessment aidcf:GateResult aidcf:ScoreSnapshot aidcf:UnknownRecord ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:ScoreSnapshot aidcf:DecisionRecommendation ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:recommends a owl:ObjectProperty ;
  rdfs:label "RECOMMENDS"@en ; skos:definition "The recommendation proposes the decision state and conditions taken up (or departed from, with reasons) by the target decision."@en ; aidcf:relationshipCode "RECOMMENDS" ;
  aidcf:cardinalityOut "0..1" ; aidcf:cardinalityIn "1..1" ;
  rdfs:domain aidcf:DecisionRecommendation ;
  rdfs:range aidcf:AssuranceDecision ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:reviewedBy a owl:ObjectProperty ;
  rdfs:label "REVIEWED_BY"@en ; skos:definition "The source record has been reviewed in the target review record."@en ; aidcf:relationshipCode "REVIEWED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:range aidcf:ReviewRecord ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:approvedBy a owl:ObjectProperty ;
  rdfs:label "APPROVED_BY"@en ; skos:definition "The source record has been approved by the authority recorded in the target review record (reviewType APPROVAL)."@en ; aidcf:relationshipCode "APPROVED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:AssuranceDecision aidcf:AssuranceStatement aidcf:AssuranceReport aidcf:ReleaseManifest aidcf:MigrationRecord aidcf:ArchitectureSnapshot aidcf:BaselineIssue aidcf:Control ) ] ;
  rdfs:range aidcf:ReviewRecord ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:reportedIn a owl:ObjectProperty ;
  rdfs:label "REPORTED_IN"@en ; skos:definition "The source is disclosed in the target report."@en ; aidcf:relationshipCode "REPORTED_IN" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:AssuranceDecision aidcf:AssuranceStatement aidcf:Finding aidcf:UnknownRecord aidcf:GateResult aidcf:ScoreSnapshot ) ] ;
  rdfs:range aidcf:AssuranceReport ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:requiresAction a owl:ObjectProperty ;
  rdfs:label "REQUIRES_ACTION"@en ; skos:definition "The source requires the target action to be completed (remediation, evidence collection, decision condition)."@en ; aidcf:relationshipCode "REQUIRES_ACTION" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Finding aidcf:UnknownRecord aidcf:AssuranceDecision aidcf:BaselineIssue ) ] ;
  rdfs:range aidcf:Action ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:closedBy a owl:ObjectProperty ;
  rdfs:label "CLOSED_BY"@en ; skos:definition "The source is closed by the target closure evidence, reassessment result or review."@en ; aidcf:relationshipCode "CLOSED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Finding aidcf:UnknownRecord aidcf:Action aidcf:BaselineIssue ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:ReviewRecord aidcf:EvidenceObject aidcf:ControlAssessment aidcf:MigrationRecord ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:invalidatedBy a owl:ObjectProperty ;
  rdfs:label "INVALIDATED_BY"@en ; skos:definition "The source can no longer be relied on because of the target event (evidence expiry, configuration drift, incident, test failure)."@en ; aidcf:relationshipCode "INVALIDATED_BY" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:EvidenceObject aidcf:CapacityAssertion aidcf:ControlAssessment aidcf:GateResult aidcf:ScoreSnapshot aidcf:AssuranceDecision aidcf:AssuranceStatement ) ] ;
  rdfs:range aidcf:Event ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:triggersReassessment a owl:ObjectProperty ;
  rdfs:label "TRIGGERS_REASSESSMENT"@en ; skos:definition "The source event or trigger rule requires reassessment of the target."@en ; aidcf:relationshipCode "TRIGGERS_REASSESSMENT" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  rdfs:domain [ a owl:Class ; owl:unionOf ( aidcf:Event aidcf:ReassessmentTrigger ) ] ;
  rdfs:range [ a owl:Class ; owl:unionOf ( aidcf:Control aidcf:ControlAssessment aidcf:GateResult aidcf:Assessment aidcf:AssuranceDecision aidcf:ServiceOutcome ) ] ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:supersedes a owl:ObjectProperty ;
  rdfs:label "SUPERSEDES"@en ; skos:definition "The source replaces the target record of the same class; the target is retained with status SUPERSEDED. Acyclic."@en ; aidcf:relationshipCode "SUPERSEDES" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..1" ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:migratedFrom a owl:ObjectProperty ;
  rdfs:label "MIGRATED_FROM"@en ; skos:definition "The source was produced from the target (prior version, legacy vocabulary or legacy record) by the migration recorded in migrationRef."@en ; aidcf:relationshipCode "MIGRATED_FROM" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "0..*" ;
  aidcf:qualifierProperty aidcf:migrationRef ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .
aidcf:integrationHandoff a owl:ObjectProperty ;
  rdfs:label "INTEGRATION_HANDOFF"@en ; skos:definition "The source AIDCF record is exchanged with the AI Trust Graph through the target reviewed handoff record (AIDCF-005)."@en ; aidcf:relationshipCode "INTEGRATION_HANDOFF" ;
  aidcf:cardinalityOut "0..*" ; aidcf:cardinalityIn "1..*" ;
  rdfs:range aidcf:IntegrationHandoff ;
  rdfs:isDefinedBy <https://w3id.org/aidcf/ontology> .

