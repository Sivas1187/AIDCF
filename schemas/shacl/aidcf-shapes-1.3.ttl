aidcf:Inverse_closes a sh:NodeShape ; sh:targetSubjectsOf aidcf:closes ; sh:property [ sh:path aidcf:closes ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property closes asserted; serialise the forward relationship CLOSED_BY" ] .
aidcf:Inverse_invalidates a sh:NodeShape ; sh:targetSubjectsOf aidcf:invalidates ; sh:property [ sh:path aidcf:invalidates ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property invalidates asserted; serialise the forward relationship INVALIDATED_BY" ] .
aidcf:Inverse_reassessmentTriggeredBy a sh:NodeShape ; sh:targetSubjectsOf aidcf:reassessmentTriggeredBy ; sh:property [ sh:path aidcf:reassessmentTriggeredBy ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property reassessmentTriggeredBy asserted; serialise the forward relationship TRIGGERS_REASSESSMENT" ] .
aidcf:Inverse_supersededBy a sh:NodeShape ; sh:targetSubjectsOf aidcf:supersededBy ; sh:property [ sh:path aidcf:supersededBy ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property supersededBy asserted; serialise the forward relationship SUPERSEDES" ] .
aidcf:Inverse_migratedTo a sh:NodeShape ; sh:targetSubjectsOf aidcf:migratedTo ; sh:property [ sh:path aidcf:migratedTo ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property migratedTo asserted; serialise the forward relationship MIGRATED_FROM" ] .
aidcf:Inverse_handoffOf a sh:NodeShape ; sh:targetSubjectsOf aidcf:handoffOf ; sh:property [ sh:path aidcf:handoffOf ; sh:maxCount 0 ; sh:message "MDM-R11: inverse property handoffOf asserted; serialise the forward relationship INTEGRATION_HANDOFF" ] .

# ---------------- Cross-object rules (SHACL-SPARQL). Rule IDs: AIDCF-014 BR-NNN and AIDCF-016 MDM-RNN.
aidcf:GatePartialNeverPassShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "SPEC 6.2: FAIL if any in-scope CRITICAL control is NONCONFORMING or PARTIAL; PARTIAL never yields PASS."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R02: a CRITICAL input is PARTIAL or NONCONFORMING but the gate is not FAIL" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:gateState ?s ; aidcf:controlEvaluations ?e . ?e aidcf:gateRole "CRITICAL" ; aidcf:controlResult ?value .
  FILTER (?value IN ("PARTIAL", "NONCONFORMING") && ?s != "FAIL")
}""" ] .

aidcf:GatePassCriticalShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "Every registry CRITICAL mapping of the gate shall be evaluated CONFORMING before the gate can PASS."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-004: gate PASS while an in-scope CRITICAL control is not evaluated as CONFORMING" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:gateState "PASS" ; aidcf:evaluatesGate ?gate .
  ?value aidcf:gateMappings ?m . ?m aidcf:gateRef ?gate ; aidcf:gateRole "CRITICAL" .
  FILTER NOT EXISTS { $this aidcf:controlEvaluations ?e . ?e aidcf:controlRef ?value ; aidcf:controlResult "CONFORMING" . }
}""" ] .

aidcf:GateEvaluationConsistencyShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "Gate inputs reproduce the result recorded on the Control Assessment."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R02: control evaluation result differs from the referenced Control Assessment" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:controlEvaluations ?e . ?e aidcf:controlAssessmentRef ?ca ; aidcf:controlResult ?value .
  ?ca aidcf:result ?r . FILTER (?r != ?value)
}""" ] .

aidcf:GatePassFloorShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "SPEC 6 evidence floors."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-004: gate PASS with gate evidence sufficiency below the gate floor" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:gateState "PASS" ; aidcf:evaluatesGate ?gate ; aidcf:evidenceSufficiency ?value .
  ?gate aidcf:evidenceFloor ?floor .
  FILTER (xsd:integer(SUBSTR(?value, 2)) < xsd:integer(SUBSTR(?floor, 2)))
}""" ] .

aidcf:GatePassEvidenceShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "AIDCF-014 BR-004."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-004: gate PASS without evidence" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:gateState "PASS" . FILTER NOT EXISTS { $this aidcf:evidencedBy ?ev } }""" ] .

aidcf:GatePassUnknownShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "SPEC 5.7 and 6.2."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R09: gate PASS while an unresolved US4 or US5 UNKNOWN is attached" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:gateState "PASS" .
  { $this aidcf:hasUnknown ?value } UNION { ?value aidcf:constrains $this }
  ?value aidcf:unknownSeverity ?sev . FILTER (?sev IN ("US4", "US5"))
  FILTER NOT EXISTS { ?value aidcf:unknownStatus "RESOLVED" }
}""" ] .

aidcf:GateCodeShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "Denormalised gate code shall equal the gate's code."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R01: gateCode does not match the evaluated Critical Gate" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:gateCode ?value ; aidcf:evaluatesGate ?g . ?g aidcf:gateCode ?gc . FILTER (?gc != ?value) }""" ] .

aidcf:GateApprovedNaShape a sh:NodeShape ; sh:targetClass aidcf:GateResult ;
  rdfs:comment "SPEC 6.2: APPROVED_NA only with approved boundary rationale."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R01: APPROVED_NA gate without rationale or approval review" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:gateState "APPROVED_NA" .
  FILTER (NOT EXISTS { $this aidcf:naRationale ?r } || NOT EXISTS { $this aidcf:reviewedBy ?a }) }""" ] .

aidcf:DecisionPositiveShape a sh:NodeShape ; sh:targetClass aidcf:AssuranceDecision ;
  rdfs:comment "UNKNOWN blocks a positive decision; gates are non-compensating."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R03 / BR-005: positive decision with a gate that is not PASS or APPROVED_NA" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:decisionState ?d ; aidcf:gateResultRefs ?value . FILTER (?d IN ("REASONABLY_ASSURED", "CONDITIONALLY_ASSURED"))
  ?value aidcf:gateState ?s . FILTER (?s NOT IN ("PASS", "APPROVED_NA"))
}""" ] .

aidcf:DecisionGateCeilingShape a sh:NodeShape ; sh:targetClass aidcf:AssuranceDecision ;
  rdfs:comment "Gate-specific ceilings carried on Critical Gate records (failCeiling, unknownCeiling)."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R05: decision exceeds the ceiling of a FAIL, UNKNOWN or NOT_ASSESSED gate" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:decisionState ?d ; aidcf:gateResultRefs ?value . ?value aidcf:gateState ?s ; aidcf:evaluatesGate ?g .
  ?g aidcf:failCeiling ?fc ; aidcf:unknownCeiling ?uc .
  BIND (IF(?s = "FAIL", ?fc, IF(?s IN ("UNKNOWN", "NOT_ASSESSED"), ?uc, "REASONABLY_ASSURED")) AS ?ceil)
  FILTER (IF(?d = "REASONABLY_ASSURED", 5, IF(?d = "CONDITIONALLY_ASSURED", 4, IF(?d = "LIMITED", 3, IF(?d = "INCONCLUSIVE", 2, IF(?d = "NOT_ASSURED", 1, 0))))) > IF(?ceil = "REASONABLY_ASSURED", 5, IF(?ceil = "CONDITIONALLY_ASSURED", 4, IF(?ceil = "LIMITED", 3, IF(?ceil = "INCONCLUSIVE", 2, IF(?ceil = "NOT_ASSURED", 1, 0))))))
}""" ] .

aidcf:DecisionUnknownCeilingShape a sh:NodeShape ; sh:targetClass aidcf:AssuranceDecision ;
  rdfs:comment "SPEC 5.7 decision-effect ceilings."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R04: decision exceeds the ceiling of an open UNKNOWN severity" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE {
  $this aidcf:decisionState ?d ; aidcf:unknownRefs ?value . ?value aidcf:unknownSeverity ?sev .
  FILTER NOT EXISTS { ?value aidcf:unknownStatus "RESOLVED" }
  FILTER ( (?sev = "US5" && ?d NOT IN ("INCONCLUSIVE", "NOT_ASSURED")) ||
           (?sev = "US4" && ?d IN ("REASONABLY_ASSURED", "CONDITIONALLY_ASSURED")) ||
           (?sev = "US3" && ?d = "REASONABLY_ASSURED") )
}""" ] .

aidcf:ReportRankShape a sh:NodeShape ; sh:targetClass aidcf:AssuranceReport ;
  rdfs:comment "Reports cannot exceed the decision."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-007: report states a decision stronger than the referenced decision" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:decisionRef ?dec ; aidcf:decisionState ?value . ?dec aidcf:decisionState ?d .
  BIND (IF(?value = "REASONABLY_ASSURED", 5, IF(?value = "CONDITIONALLY_ASSURED", 4, IF(?value = "LIMITED", 3, IF(?value = "INCONCLUSIVE", 2, IF(?value = "NOT_ASSURED", 1, 0))))) AS ?rk) BIND (IF(?d = "REASONABLY_ASSURED", 5, IF(?d = "CONDITIONALLY_ASSURED", 4, IF(?d = "LIMITED", 3, IF(?d = "INCONCLUSIVE", 2, IF(?d = "NOT_ASSURED", 1, 0))))) AS ?rk2)
  FILTER (?rk > ?rk2) }""" ] .

aidcf:StatementRankShape a sh:NodeShape ; sh:targetClass aidcf:AssuranceStatement ;
  rdfs:comment "Statements cannot exceed the decision."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-007: statement states a decision stronger than the referenced decision" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:decisionRef ?dec ; aidcf:decisionState ?value . ?dec aidcf:decisionState ?d .
  BIND (IF(?value = "REASONABLY_ASSURED", 5, IF(?value = "CONDITIONALLY_ASSURED", 4, IF(?value = "LIMITED", 3, IF(?value = "INCONCLUSIVE", 2, IF(?value = "NOT_ASSURED", 1, 0))))) AS ?rk) BIND (IF(?d = "REASONABLY_ASSURED", 5, IF(?d = "CONDITIONALLY_ASSURED", 4, IF(?d = "LIMITED", 3, IF(?d = "INCONCLUSIVE", 2, IF(?d = "NOT_ASSURED", 1, 0))))) AS ?rk2)
  FILTER (?rk > ?rk2) }""" ] .

aidcf:AssessmentFindingShape a sh:NodeShape ; sh:targetClass aidcf:ControlAssessment ;
  rdfs:comment "SPEC 5.2."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "TR-11: PARTIAL or NONCONFORMING result without a Finding" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:result ?value . FILTER (?value IN ("PARTIAL", "NONCONFORMING"))
  FILTER NOT EXISTS { $this aidcf:hasFinding ?f } }""" ] .

aidcf:AssessmentUnknownShape a sh:NodeShape ; sh:targetClass aidcf:ControlAssessment ;
  rdfs:comment "UNKNOWN is first-class."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "TR-11: UNKNOWN result without an UNKNOWN Record" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:result "UNKNOWN" . FILTER NOT EXISTS { $this aidcf:hasUnknown ?u } }""" ] .

aidcf:AssessmentNaShape a sh:NodeShape ; sh:targetClass aidcf:ControlAssessment ;
  rdfs:comment "AIDCF-014 BR-002."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-002: NOT_APPLICABLE without rationale and review" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:result "NOT_APPLICABLE" .
  FILTER (NOT EXISTS { $this aidcf:naRationale ?r } || NOT EXISTS { $this aidcf:reviewedBy ?a }) }""" ] .

aidcf:AssessmentConformingFloorShape a sh:NodeShape ; sh:targetClass aidcf:ControlAssessment ;
  rdfs:comment "Insufficient evidence makes the result UNKNOWN (SPEC 5.12)."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R07: CONFORMING result with evidence sufficiency below the control's evidence floor" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:result "CONFORMING" ; aidcf:evidenceSufficiency ?value .
  ?c aidcf:assessedBy $this ; aidcf:claimType ?ct ; aidcf:hasEvidenceRequirement ?er . ?er aidcf:claimType ?ct ; aidcf:sufficiencyFloor ?floor .
  FILTER (xsd:integer(SUBSTR(?value, 2)) < xsd:integer(SUBSTR(?floor, 2))) }""" ] .

aidcf:AssessmentClaimTypeShape a sh:NodeShape ; sh:targetClass aidcf:ControlAssessment ;
  rdfs:comment "A result is valid only for the claim type assessed."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-003: assessed claim type is below the control's required claim type" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:claimType ?value . ?c aidcf:assessedBy $this ; aidcf:claimType ?ct .
  FILTER (IF(?value = "DESIGN", 2, IF(?value = "IMPLEMENTATION", 3, IF(?value = "OPERATION", 4, IF(?value = "EFFECTIVENESS", 5, IF(?value = "RESILIENCE", 5, 0))))) < IF(?ct = "DESIGN", 2, IF(?ct = "IMPLEMENTATION", 3, IF(?ct = "OPERATION", 4, IF(?ct = "EFFECTIVENESS", 5, IF(?ct = "RESILIENCE", 5, 0)))))) }""" ] .

aidcf:ControlAssuranceLevelShape a sh:NodeShape ; sh:targetNode <https://w3id.org/aidcf/ontology> ;
  rdfs:comment "registries/vocabularies/claim-types.csv minimumAssuranceLevel. Graph-level constraint: the focus node is the ontology and the value is the offending Control."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R08: required assurance level inconsistent with claim type" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { ?value a aidcf:Control ; aidcf:claimType ?ct ; aidcf:requiredAssuranceLevel ?al .
  FILTER (IF(?ct = "DESIGN", "AL2", IF(?ct = "IMPLEMENTATION", "AL3", IF(?ct = "OPERATION", "AL4", IF(?ct = "EFFECTIVENESS", "AL5", IF(?ct = "RESILIENCE", "AL5", ""))))) != ?al) }""" ] .

aidcf:UnknownUs4GateShape a sh:NodeShape ; sh:targetClass aidcf:UnknownRecord ;
  rdfs:comment "SPEC 5.7: a US4 UNKNOWN sets the affected gate to UNKNOWN."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R09: open US4 UNKNOWN does not constrain a GateResult that is UNKNOWN or FAIL" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:unknownSeverity "US4" . FILTER NOT EXISTS { $this aidcf:unknownStatus "RESOLVED" }
  FILTER NOT EXISTS { $this aidcf:constrains ?g . ?g a aidcf:GateResult ; aidcf:gateState ?s . FILTER (?s IN ("UNKNOWN", "FAIL")) } }""" ] .

aidcf:UnknownDispositionShape a sh:NodeShape ; sh:targetClass aidcf:UnknownRecord ;
  rdfs:comment "CG-12 disposition evidence."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R19: DISPOSITIONED UNKNOWN without disposition and due date" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { $this aidcf:unknownStatus "DISPOSITIONED" .
  FILTER (NOT EXISTS { $this aidcf:disposition ?d } || NOT EXISTS { $this aidcf:dueDate ?x }) }""" ] .

aidcf:EventCandidateShape a sh:NodeShape ; sh:targetClass aidcf:Event ;
  rdfs:comment "Automation proposes; events do not auto-approve (TDS-REQ-062)."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "BR-011: event awaiting disposition is not CANDIDATE" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { $this aidcf:humanDisposition "PENDING" ; aidcf:reviewState ?value . FILTER (?value != "CANDIDATE") }""" ] .

aidcf:RelationshipRecordEdgeShape a sh:NodeShape ; sh:targetNode <https://w3id.org/aidcf/ontology> ;
  rdfs:comment "Relationship envelope records and the graph projection shall agree. Graph-level constraint: the value is the offending relationship record."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R10: relationship record has no corresponding asserted edge" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { ?value a aidcf:RelationshipRecord ; aidcf:relationshipType ?code ; aidcf:sourceRef ?s ; aidcf:targetRef ?o .
  ?p aidcf:relationshipCode ?code . FILTER NOT EXISTS { ?s ?p ?o } }""" ] .

aidcf:EdgeRecordShape a sh:NodeShape ; sh:targetNode <https://w3id.org/aidcf/ontology> ;
  rdfs:comment "AIDCF-014 TDS-REQ-041: every edge is a first-class record. Graph-level constraint: the value is the source of the unrecorded edge."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R10: asserted edge has no relationship record" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { ?value ?p ?o . ?p aidcf:relationshipCode ?code .
  FILTER NOT EXISTS { ?r aidcf:relationshipType ?code ; aidcf:sourceRef ?value ; aidcf:targetRef ?o } }""" ] .

aidcf:RelationshipQualifier_DEPENDS_ON_dependencyRef a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "DEPENDS_ON" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:dependencyRef ; sh:minCount 1 ; sh:message "MDM-R10: DEPENDS_ON relationship record lacks mandatory qualifier dependencyRef" ] .

aidcf:RelationshipQualifier_SHARES_FAULT_DOMAIN_WITH_faultDomainRef a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "SHARES_FAULT_DOMAIN_WITH" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:faultDomainRef ; sh:minCount 1 ; sh:message "MDM-R10: SHARES_FAULT_DOMAIN_WITH relationship record lacks mandatory qualifier faultDomainRef" ] .

aidcf:RelationshipQualifier_PROPAGATES_TO_scenarioRef a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "PROPAGATES_TO" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:scenarioRef ; sh:minCount 1 ; sh:message "MDM-R10: PROPAGATES_TO relationship record lacks mandatory qualifier scenarioRef" ] .

aidcf:RelationshipQualifier_PROPAGATES_TO_stepOrdinal a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "PROPAGATES_TO" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:stepOrdinal ; sh:minCount 1 ; sh:message "MDM-R10: PROPAGATES_TO relationship record lacks mandatory qualifier stepOrdinal" ] .

aidcf:RelationshipQualifier_CONSTRAINS_constraintType a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "CONSTRAINS" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:constraintType ; sh:minCount 1 ; sh:message "MDM-R10: CONSTRAINS relationship record lacks mandatory qualifier constraintType" ] .

aidcf:RelationshipQualifier_MIGRATED_FROM_migrationRef a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "MIGRATED_FROM" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:migrationRef ; sh:minCount 1 ; sh:message "MDM-R10: MIGRATED_FROM relationship record lacks mandatory qualifier migrationRef" ] .

aidcf:RelationshipQualifier_DEPENDS_ON_operatingStates a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "DEPENDS_ON" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:operatingStates ; sh:minCount 1 ; sh:message "MDM-R10: DEPENDS_ON relationship record lacks mandatory condition operatingStates" ] .

aidcf:RelationshipQualifier_PROTECTED_BY_operatingStates a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "PROTECTED_BY" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:operatingStates ; sh:minCount 1 ; sh:message "MDM-R10: PROTECTED_BY relationship record lacks mandatory condition operatingStates" ] .

aidcf:RelationshipQualifier_PROPAGATES_TO_operatingStates a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "PROPAGATES_TO" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:operatingStates ; sh:minCount 1 ; sh:message "MDM-R10: PROPAGATES_TO relationship record lacks mandatory condition operatingStates" ] .

aidcf:RelationshipQualifier_RECOVERS_THROUGH_operatingStates a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "RECOVERS_THROUGH" }""" ] ;
  rdfs:comment "AIDCF-014 section 10 qualifiers and conditions."@en ;
  sh:property [ sh:path aidcf:operatingStates ; sh:minCount 1 ; sh:message "MDM-R10: RECOVERS_THROUGH relationship record lacks mandatory condition operatingStates" ] .

aidcf:GateRoleQualifierShape a sh:NodeShape ;
  sh:target [ a sh:SPARQLTarget ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ; sh:select """SELECT ?this WHERE { ?this aidcf:relationshipType "EVALUATES_GATE" ; aidcf:sourceRef ?s . ?s a aidcf:Control . }""" ] ;
  rdfs:comment "AIDCF-014 section 9 row 28."@en ;
  sh:property [ sh:path aidcf:gateRole ; sh:minCount 1 ; sh:message "MDM-R10: Control to CriticalGate edge without gateRole" ] .

aidcf:ClassificationDistributionShape a sh:NodeShape ; sh:targetClass aidcf:AidcfRecord ;
  rdfs:comment "AIDCF-014 section 8 and BR-012."@en ;
  sh:message "BR-012: record above INTERNAL without a DistributionControl" ;
  sh:or ( [ sh:property [ sh:path aidcf:classification ; sh:in ( "PUBLIC" "INTERNAL" ) ] ]
          [ sh:property [ sh:path aidcf:distributionControlRef ; sh:minCount 1 ] ] ) .

aidcf:EdgeClassificationShape a sh:NodeShape ; sh:targetNode <https://w3id.org/aidcf/ontology> ;
  rdfs:comment "TDS-REQ-065: an edge inherits at least the higher classification of its endpoints. Graph-level constraint."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R12: edge classified below one of its endpoints" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this ?value WHERE { ?value a aidcf:RelationshipRecord ; aidcf:classification ?c ; aidcf:sourceRef ?s ; aidcf:targetRef ?o .
  { ?s aidcf:classification ?ec } UNION { ?o aidcf:classification ?ec }
  FILTER (IF(?c = "PUBLIC", 0, IF(?c = "INTERNAL", 1, IF(?c = "CLIENT_RESTRICTED", 2, IF(?c = "CONFIDENTIAL", 3, IF(?c = "HIGHLY_RESTRICTED", 4, 0))))) < IF(?ec = "PUBLIC", 0, IF(?ec = "INTERNAL", 1, IF(?ec = "CLIENT_RESTRICTED", 2, IF(?ec = "CONFIDENTIAL", 3, IF(?ec = "HIGHLY_RESTRICTED", 4, 0)))))) }""" ] .

aidcf:ApprovalReviewTypeShape a sh:NodeShape ; sh:targetObjectsOf aidcf:approvedBy ;
  rdfs:comment "AIDCF-014 section 9 row 33."@en ;
  sh:sparql [ a sh:SPARQLConstraint ; sh:message "MDM-R17: APPROVED_BY target is not a review record of type APPROVAL" ; sh:prefixes <https://w3id.org/aidcf/shapes/1.3> ;
    sh:select """SELECT $this WHERE { FILTER NOT EXISTS { $this aidcf:reviewType "APPROVAL" } }""" ] .

